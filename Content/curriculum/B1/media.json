  "stories": [
    {
      "id": "b1-media-1",
      "title": "Fake News",
      "title_tr": "Yalan haber",
      "names": [
        "Ali",
        "Hasan"
      ],
      "lines": [
        {
          "en": "Did you read this new article?",
          "tr": "Bu yeni makaleyi okudun mu?"
        },
        {
          "en": "No, I didn't. What is it about?",
          "tr": "Hayır, okumadım. Ne hakkında?"
        },
        {
          "en": "According to the article, they will close the airport.",
          "tr": "Makaleye göre, havalimanını kapatacaklar."
        },
        {
          "en": "I'm not sure about that. What is the source?",
          "tr": "Bundan emin değilim. Kaynağı ne?"
        },
        {
          "en": "Actually, I think it is fake.",
          "tr": "Aslında sanırım yalan."
        },
        {
          "en": "Yes, it doesn't seem accurate.",
          "tr": "Evet, doğru görünmüyor."
        }
      ]
    },
    {
      "id": "b1-media-2",
      "title": "A Popular Video",
      "title_tr": "Popüler video",
      "names": [
        "Zeynep",
        "Elif"
      ],
      "lines": [
        {
          "en": "Have you seen my new post?",
          "tr": "Yeni paylaşımımı gördün mü?"
        },
        {
          "en": "Yes! A lot of people share it.",
          "tr": "Evet! Bir sürü insan onu paylaşıyor."
        },
        {
          "en": "It went viral recently.",
          "tr": "Geçenlerde internette çok yayıldı."
        },
        {
          "en": "I read the comments. They are very funny.",
          "tr": "Yorumları okudum. Çok komikler."
        },
        {
          "en": "I will answer them later.",
          "tr": "Onlara daha sonra cevap vereceğim."
        }
      ]
    },
    {
      "id": "b1-media-3",
      "title": "A New Documentary",
      "title_tr": "Yeni bir belgesel",
      "names": [
        "Burak",
        "Cem"
      ],
      "lines": [
        {
          "en": "Did you hear about the new documentary?",
          "tr": "Yeni belgeseli duydun mu?"
        },
        {
          "en": "No. Which channel is it on?",
          "tr": "Hayır. Hangi kanalda?"
        },
        {
          "en": "It is on channel four.",
          "tr": "Kanal dörtte."
        },
        {
          "en": "Is it a good programme?",
          "tr": "İyi bir program mı?"
        },
        {
          "en": "Yes, the audience loves it.",
          "tr": "Evet, izleyiciler onu çok seviyor."
        }
      ]
    },
    {
      "id": "b1-media-4",
      "title": "Privacy Online",
      "title_tr": "İnternette gizlilik",
      "names": [
        "Ayşe",
        "Fatma"
      ],
      "lines": [
        {
          "en": "I need to update my phone.",
          "tr": "Telefonumu güncellemem lazım."
        },
        {
          "en": "Why? Is there a problem?",
          "tr": "Neden? Bir problem mi var?"
        },
        {
          "en": "I read somewhere that old devices are dangerous.",
          "tr": "Bir yerde eski cihazların tehlikeli olduğunu okudum."
        },
        {
          "en": "That makes sense. Privacy is very important.",
          "tr": "Bu mantıklı. Gizlilik çok önemlidir."
        },
        {
          "en": "I agree with you.",
          "tr": "Sana katılıyorum."
        }
      ]
    },
    {
      "id": "b1-media-5",
      "title": "The Media and the News",
      "title_tr": "Medya ve haberler",
      "names": [
        "Leyla",
        "Murat"
      ],
      "lines": [
        {
          "en": "The journalist will announce some big news tonight.",
          "tr": "Gazeteci bu gece büyük bir haber duyuracak."
        },
        {
          "en": "Where did you see the headline?",
          "tr": "Manşeti nerede gördün?"
        },
        {
          "en": "I saw an advertisement on the internet.",
          "tr": "İnternette bir reklam gördüm."
        },
        {
          "en": "I will inform my brother. When does the broadcast start?",
          "tr": "Kardeşime haber vereceğim. Yayın ne zaman başlıyor?"
        },
        {
          "en": "At nine. The media is very busy.",
          "tr": "Dokuzda. Medya çok meşgul."
        }
      ]
    }
  ]
}
