  "stories": [
    {
      "id": "b1-feelings-1",
      "title": "Tartışma",
      "names": [
        "Zeynep",
        "Ali"
      ],
      "lines": [
        {
          "en": "Zeynep and Ali had an argument yesterday.",
          "tr": "Zeynep ve Ali dün tartıştılar."
        },
        {
          "en": "Ali is in a very bad mood today.",
          "tr": "Ali bugün çok kötü bir ruh halinde."
        },
        {
          "en": "I'm fed up with his rude attitude.",
          "tr": "Onun kaba tavrından bıktım."
        },
        {
          "en": "He never listens to my opinions!",
          "tr": "Benim fikirlerimi hiç dinlemiyor!"
        },
        {
          "en": "You should be patient and talk to him later.",
          "tr": "Sabırlı olmalı ve onunla daha sonra konuşmalısın."
        }
      ]
    },
    {
      "id": "b1-feelings-2",
      "title": "Özür dilemek",
      "names": [
        "Mert",
        "Leyla"
      ],
      "lines": [
        {
          "en": "Mert was very upset about the meeting.",
          "tr": "Mert toplantı hakkında çok üzgündü."
        },
        {
          "en": "I apologize, Leyla. I didn't mean to be rude.",
          "tr": "Özür dilerim, Leyla. Kaba olmak istememiştim."
        },
        {
          "en": "I was just nervous about the interview.",
          "tr": "Sadece mülakat için gergindim."
        },
        {
          "en": "Never mind. I know you respect me.",
          "tr": "Boş ver. Bana saygı duyduğunu biliyorum."
        },
        {
          "en": "I hope you can forgive me.",
          "tr": "Umarım beni affedebilirsin."
        },
        {
          "en": "Yes. We always support each other.",
          "tr": "Evet. Birbirimizi her zaman destekleriz."
        }
      ]
    },
    {
      "id": "b1-feelings-3",
      "title": "Sınav stresi",
      "names": [
        "Ayşe"
      ],
      "lines": [
        {
          "en": "Ayşe is taking an important exam tomorrow.",
          "tr": "Ayşe yarın önemli bir sınava giriyor."
        },
        {
          "en": "I'm worried I will fail.",
          "tr": "Başarısız olacağımdan endişeleniyorum."
        },
        {
          "en": "Don't be disappointed before you try!",
          "tr": "Denemeden hayal kırıklığına uğrama!"
        },
        {
          "en": "I encourage you to be confident.",
          "tr": "Kendinden emin olmanı teşvik ediyorum."
        },
        {
          "en": "I am already proud of you.",
          "tr": "Seninle şimdiden gurur duyuyorum."
        },
        {
          "en": "I feel better now. I'm looking forward to the weekend!",
          "tr": "Şimdi daha iyi hissediyorum. Hafta sonunu dört gözle bekliyorum!"
        }
      ]
    },
    {
      "id": "b1-feelings-4",
      "title": "Güven problemi",
      "names": [
        "David",
        "Sarah"
      ],
      "lines": [
        {
          "en": "Sarah and David had a beautiful relationship.",
          "tr": "Sarah ve David'in güzel bir ilişkisi vardı."
        },
        {
          "en": "But David was always very jealous.",
          "tr": "Ama David hep çok kıskançtı."
        },
        {
          "en": "To be honest, I don't trust you.",
          "tr": "Dürüst olmak gerekirse, sana güvenmiyorum."
        },
        {
          "en": "Now David is single and feels lonely.",
          "tr": "Şimdi David bekar ve yalnız hissediyor."
        },
        {
          "en": "It's not your fault, Sarah. He was too jealous.",
          "tr": "Senin suçun değil, Sarah. O çok kıskançtı."
        }
      ]
    },
    {
      "id": "b1-feelings-5",
      "title": "Rahatlama zamanı",
      "names": [
        "Cem"
      ],
      "lines": [
        {
          "en": "Cem is usually very busy.",
          "tr": "Cem genelde çok meşguldür."
        },
        {
          "en": "Recently, he looks very relaxed.",
          "tr": "Son zamanlarda çok rahatlamış görünüyor."
        },
        {
          "en": "I am curious about his new attitude.",
          "tr": "Yeni tavrını merak ediyorum."
        },
        {
          "en": "I realized that I need to rest.",
          "tr": "Dinlenmem gerektiğini fark ettim."
        },
        {
          "en": "I sleep eight hours every night.",
          "tr": "Her gece sekiz saat uyuyorum."
        },
        {
          "en": "That makes sense. I should do the same.",
          "tr": "Mantıklı. Ben de aynısını yapmalıyım."
        }
      ]
    }
  ]
}
