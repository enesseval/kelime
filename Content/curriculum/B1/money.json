  "stories": [
    {
      "id": "b1-money-1",
      "title": "Kötü Bir Bilgisayar",
      "names": [
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Zeynep wants to complain about her new computer.",
          "tr": "Zeynep yeni bilgisayarı hakkında şikâyet etmek istiyor."
        },
        {
          "en": "The quality is very bad. I have a complaint.",
          "tr": "Kalitesi çok kötü. Bir şikâyetim var."
        },
        {
          "en": "Can I get a refund, please?",
          "tr": "İade alabilir miyim, lütfen?"
        },
        {
          "en": "Do you have the receipt?",
          "tr": "Fişiniz var mı?"
        },
        {
          "en": "Yes, here it is.",
          "tr": "Evet, buyurun."
        },
        {
          "en": "We can offer a new computer instead.",
          "tr": "Bunun yerine yeni bir bilgisayar sunabiliriz."
        },
        {
          "en": "No, it's not worth it. I want my money back.",
          "tr": "Hayır, değmez. Paramı geri istiyorum."
        }
      ]
    },
    {
      "id": "b1-money-2",
      "title": "Pazarda",
      "names": [
        "Ahmet",
        "John"
      ],
      "lines": [
        {
          "en": "John and Ahmet are at a market.",
          "tr": "John ve Ahmet bir pazardalar."
        },
        {
          "en": "I like this bag, but it's expensive.",
          "tr": "Bu çantayı sevdim ama pahalı."
        },
        {
          "en": "You can bargain here. Ask for a discount.",
          "tr": "Burada pazarlık yapabilirsin. İndirim iste."
        },
        {
          "en": "Is there a discount? I can't afford it.",
          "tr": "İndirim var mı? Buna gücüm yetmez."
        },
        {
          "en": "Yes, it's on sale today. It's a bargain.",
          "tr": "Evet, bugün indirimde. Tam kelepir."
        },
        {
          "en": "Great! Do you accept cash?",
          "tr": "Harika! Nakit kabul ediyor musunuz?"
        },
        {
          "en": "Yes. But we don't deliver.",
          "tr": "Evet. Ama teslimat yapmıyoruz."
        }
      ]
    },
    {
      "id": "b1-money-3",
      "title": "Banka Kredisi",
      "names": [
        "Ali",
        "London"
      ],
      "lines": [
        {
          "en": "Ali lives in London. He has a lot of debt.",
          "tr": "Ali Londra'da yaşıyor. Çok borcu var."
        },
        {
          "en": "I owe the bank a lot of money.",
          "tr": "Bankaya çok para borçluyum."
        },
        {
          "en": "Are you poor? You work very hard.",
          "tr": "Fakir misin? Çok sıkı çalışıyorsun."
        },
        {
          "en": "I'm not rich. I spend too much.",
          "tr": "Zengin değilim. Çok harcıyorum."
        },
        {
          "en": "You must save money and plan your budget.",
          "tr": "Para biriktirmeli ve bütçeni planlamalısın."
        },
        {
          "en": "That makes sense. Buying expensive shoes is a waste of money.",
          "tr": "Mantıklı. Pahalı ayakkabılar almak para israfı."
        }
      ]
    },
    {
      "id": "b1-money-4",
      "title": "Yeni Araba",
      "names": [
        "Ayşe",
        "Emre"
      ],
      "lines": [
        {
          "en": "Emre wants to buy a car. Ayşe doesn't agree.",
          "tr": "Emre araba almak istiyor. Ayşe aynı fikirde değil."
        },
        {
          "en": "We can get a loan from the bank.",
          "tr": "Bankadan kredi alabiliriz."
        },
        {
          "en": "I'm not sure about that. We can't afford it.",
          "tr": "Ondan emin değilim. Gücümüz yetmez."
        },
        {
          "en": "But the car has great value. It's a good offer.",
          "tr": "Ama arabanın değeri büyük. İyi bir teklif."
        },
        {
          "en": "In my opinion, taking a big loan is dangerous.",
          "tr": "Bence büyük bir kredi çekmek tehlikeli."
        },
        {
          "en": "You are right. Let's save money first.",
          "tr": "Haklısın. Önce para biriktirelim."
        }
      ]
    },
    {
      "id": "b1-money-5",
      "title": "Kötü Teslimat",
      "names": [
        "Fatma",
        "Turkey"
      ],
      "lines": [
        {
          "en": "Fatma is in Turkey. She orders a dress online.",
          "tr": "Fatma Türkiye'de. İnternetten bir elbise sipariş ediyor."
        },
        {
          "en": "The delivery is very late. I'm angry.",
          "tr": "Teslimat çok gecikti. Kızgınım."
        },
        {
          "en": "When did they deliver it?",
          "tr": "Ne zaman teslim ettiler?"
        },
        {
          "en": "Yesterday. But the dress is too small.",
          "tr": "Dün. Ama elbise çok küçük."
        },
        {
          "en": "It's a waste of money. Complain about it.",
          "tr": "Para israfı. Şikâyet et."
        },
        {
          "en": "I will. Can I get a refund?",
          "tr": "Edeceğim. İade alabilir miyim?"
        },
        {
          "en": "Yes, if you have the receipt.",
          "tr": "Evet, fişin varsa."
        }
      ]
    }
  ]
}
