  "stories": [
    {
      "id": "b1-career-1",
      "title": "The Job Interview",
      "title_tr": "İş Görüşmesi",
      "names": [
        "Leyla"
      ],
      "lines": [
        {
          "en": "Good morning, Leyla. I see your application.",
          "tr": "Günaydın Leyla. Başvurunuzu görüyorum."
        },
        {
          "en": "Yes, I'd like to apply for the manager job.",
          "tr": "Evet, yönetici işine başvurmak istiyorum."
        },
        {
          "en": "What qualifications do you have?",
          "tr": "Ne gibi nitelikleriniz var?"
        },
        {
          "en": "I have experience in this subject. I am very reliable.",
          "tr": "Bu konuda deneyimim var. Çok güvenilirimdir."
        },
        {
          "en": "Could you tell me more about your old job?",
          "tr": "Eski işiniz hakkında bilgi verir misiniz?"
        },
        {
          "en": "I was responsible for a big team.",
          "tr": "Büyük bir takımdan sorumluydum."
        }
      ]
    },
    {
      "id": "b1-career-2",
      "title": "Hoping for a Promotion",
      "title_tr": "Terfi Beklentisi",
      "names": [
        "Emre"
      ],
      "lines": [
        {
          "en": "Emre works in a big company. He is very efficient.",
          "tr": "Emre büyük bir şirkette çalışıyor. Çok verimli biri."
        },
        {
          "en": "I expect a promotion this year.",
          "tr": "Bu yıl terfi bekliyorum."
        },
        {
          "en": "You have a lot of ambition.",
          "tr": "Çok hırsın var."
        },
        {
          "en": "Yes, my goal is to be the new boss.",
          "tr": "Evet, hedefim yeni patron olmak."
        },
        {
          "en": "Did you achieve your old goals?",
          "tr": "Eski hedeflerine ulaştın mı?"
        },
        {
          "en": "Yes, I always succeed.",
          "tr": "Evet, her zaman başarılı olurum."
        }
      ]
    },
    {
      "id": "b1-career-3",
      "title": "A New Beginning",
      "title_tr": "Yeni Bir Başlangıç",
      "names": [
        "Hasan"
      ],
      "lines": [
        {
          "en": "My father Hasan will retire tomorrow.",
          "tr": "Babam Hasan yarın emekli olacak."
        },
        {
          "en": "What will he do?",
          "tr": "Ne yapacak?"
        },
        {
          "en": "He doesn't want to be unemployed.",
          "tr": "İşsiz olmak istemiyor."
        },
        {
          "en": "He has a lot of knowledge about computers.",
          "tr": "Bilgisayarlar hakkında çok bilgisi var."
        },
        {
          "en": "He wants to start a new company.",
          "tr": "Yeni bir şirket kurmak istiyor."
        },
        {
          "en": "That's a great opportunity for him.",
          "tr": "Bu onun için harika bir fırsat."
        }
      ]
    },
    {
      "id": "b1-career-4",
      "title": "The First Day of Training",
      "title_tr": "İlk Eğitim Günü",
      "names": [
        "Defne",
        "Izmir"
      ],
      "lines": [
        {
          "en": "Defne is a candidate for a new job in Izmir.",
          "tr": "Defne İzmir'deki yeni bir iş için aday."
        },
        {
          "en": "She starts her training today.",
          "tr": "Eğitimine bugün başlıyor."
        },
        {
          "en": "I need to develop my computer skills.",
          "tr": "Bilgisayar becerilerimi geliştirmem lazım."
        },
        {
          "en": "You will improve soon.",
          "tr": "Yakında gelişeceksin."
        },
        {
          "en": "I'm in charge of your training.",
          "tr": "Eğitiminden ben sorumluyum."
        },
        {
          "en": "I am happy. I want to be ready.",
          "tr": "Mutluyum. Hazır olmak istiyorum."
        }
      ]
    },
    {
      "id": "b1-career-5",
      "title": "A Difficult Contract",
      "title_tr": "Zorlu Sözleşme",
      "names": [
        "Ozan",
        "Sarah"
      ],
      "lines": [
        {
          "en": "Ozan, did you read the new contract?",
          "tr": "Ozan, yeni sözleşmeyi okudun mu?"
        },
        {
          "en": "Yes, Sarah. It seems very difficult.",
          "tr": "Evet Sarah. Çok zor görünüyor."
        },
        {
          "en": "It is a big challenge for us.",
          "tr": "Bizim için büyük bir meydan okuma."
        },
        {
          "en": "I'm in charge of this situation.",
          "tr": "Bu durumdan ben sorumluyum."
        },
        {
          "en": "We must work together for success.",
          "tr": "Başarı için birlikte çalışmalıyız."
        },
        {
          "en": "I agree with you. We can manage it.",
          "tr": "Sana katılıyorum. Bunu halledebiliriz."
        }
      ]
    }
  ],
  "names": [
    "English"
  ]
}
