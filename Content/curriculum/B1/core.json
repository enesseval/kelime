  "stories": [
    {
      "id": "b1-core-1",
      "title": "İş Kararı",
      "names": [
        "Ali",
        "Sarah",
        "London"
      ],
      "lines": [
        {
          "en": "Ali and Sarah are in a meeting in London.",
          "tr": "Ali ve Sarah Londra'da bir toplantıdalar."
        },
        {
          "en": "We need to replace our old computers.",
          "tr": "Eski bilgisayarlarımızı değiştirmemiz gerekiyor."
        },
        {
          "en": "I agree with you, but they are very expensive.",
          "tr": "Sana katılıyorum ama onlar çok pahalı."
        },
        {
          "en": "In my opinion, it is a necessary decision.",
          "tr": "Bence bu gerekli bir karar."
        },
        {
          "en": "That makes sense. Can we manage to do it this year?",
          "tr": "Bu mantıklı. Bunu bu yıl halletmeyi başarabilir miyiz?"
        },
        {
          "en": "Yes, if we avoid buying expensive furniture.",
          "tr": "Evet, pahalı mobilyalar almaktan kaçınırsak."
        },
        {
          "en": "OK, it's worth trying.",
          "tr": "Tamam, denemeye değer."
        }
      ]
    },
    {
      "id": "b1-core-2",
      "title": "Tatil Planı",
      "names": [
        "Canan",
        "David",
        "Antalya"
      ],
      "lines": [
        {
          "en": "Canan and David are planning a summer holiday in Antalya.",
          "tr": "Canan ve David Antalya'da bir yaz tatili planlıyorlar."
        },
        {
          "en": "I want to stay in a quiet village this year.",
          "tr": "Bu yıl sessiz bir köyde kalmak istiyorum."
        },
        {
          "en": "I'm not sure about that. It might be too quiet.",
          "tr": "Ondan emin değilim. Fazla sessiz olabilir."
        },
        {
          "en": "As far as I know, there are various festivals in summer.",
          "tr": "Bildiğim kadarıyla yazın çeşitli festivaller oluyor."
        },
        {
          "en": "On the other hand, a big hotel has an advantage. It is near the sea.",
          "tr": "Öte yandan, büyük bir otelin bir avantajı var. Denize yakın."
        },
        {
          "en": "Although you are right, I prefer the countryside.",
          "tr": "Haklı olmana rağmen ben kırsalı tercih ederim."
        },
        {
          "en": "OK, let's compare prices before we decide.",
          "tr": "Tamam, karar vermeden önce fiyatları karşılaştıralım."
        }
      ]
    },
    {
      "id": "b1-core-3",
      "title": "Zor Durum",
      "names": [
        "Emre",
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Emre notices that Zeynep seems worried.",
          "tr": "Emre, Zeynep'in endişeli göründüğünü fark eder."
        },
        {
          "en": "What is the problem? You've looked very tired recently.",
          "tr": "Sorun nedir? Son zamanlarda çok yorgun görünüyorsun."
        },
        {
          "en": "I didn't realize it was obvious. I am in a difficult situation.",
          "tr": "Belli olduğunu fark etmemiştim. Zor bir durumdayım."
        },
        {
          "en": "Can you explain it to me? Maybe I can help.",
          "tr": "Bana açıklayabilir misin? Belki yardım edebilirim."
        },
        {
          "en": "My boss expects me to work on weekends.",
          "tr": "Patronum hafta sonları çalışmamı bekliyor."
        },
        {
          "en": "You shouldn't accept unless he pays you more money.",
          "tr": "Sana daha fazla para ödemedikçe kabul etmemelisin."
        },
        {
          "en": "Actually, you are right. I will talk to him tomorrow.",
          "tr": "Aslında haklısın. Onunla yarın konuşacağım."
        }
      ]
    }
  ]
}
