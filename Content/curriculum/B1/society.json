  "stories": [
    {
      "id": "b1-society-1",
      "title": "Ulaşım sorunu",
      "names": [
        "Burak",
        "London"
      ],
      "lines": [
        {
          "en": "Burak lives in London. The population is big.",
          "tr": "Burak Londra'da yaşıyor. Nüfus büyük."
        },
        {
          "en": "In my area, there isn't enough public transport.",
          "tr": "Benim yaşadığım yerde, yeterli toplu taşıma yok."
        },
        {
          "en": "The traffic is always bad.",
          "tr": "Trafik her zaman kötü."
        },
        {
          "en": "Something should change!",
          "tr": "Bir şeyler değişmeli!"
        },
        {
          "en": "I agree with you. It's a big problem.",
          "tr": "Sana katılıyorum. Bu büyük bir problem."
        }
      ]
    },
    {
      "id": "b1-society-2",
      "title": "Kurallar ve yasalar",
      "names": [
        "Ayşe",
        "Eda"
      ],
      "lines": [
        {
          "en": "Ayşe and Eda are at a park.",
          "tr": "Ayşe ve Eda bir parktalar."
        },
        {
          "en": "Eda, don't leave your rubbish here!",
          "tr": "Eda, çöpünü buraya bırakma!"
        },
        {
          "en": "Why not? There are no rules.",
          "tr": "Neden olmasın? Kural yok."
        },
        {
          "en": "Actually, there are. It's against the law.",
          "tr": "Aslında var. Yasaya aykırı."
        },
        {
          "en": "You are right. Public areas should be clean.",
          "tr": "Haklısın. Kamusal alanlar temiz olmalı."
        }
      ]
    },
    {
      "id": "b1-society-3",
      "title": "Toplum için gönüllülük",
      "names": [
        "Ali",
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Our community needs help.",
          "tr": "Toplumumuzun yardıma ihtiyacı var."
        },
        {
          "en": "Yes, we should start a charity.",
          "tr": "Evet, bir hayır kurumu kurmalıyız."
        },
        {
          "en": "We can find volunteers for the weekend.",
          "tr": "Hafta sonu için gönüllüler bulabiliriz."
        },
        {
          "en": "That makes sense. People tend to help.",
          "tr": "Bu mantıklı. İnsanlar yardım etme eğilimindedir."
        },
        {
          "en": "The facilities in our neighbourhood will be better.",
          "tr": "Mahallemizdeki tesisler daha iyi olacak."
        }
      ]
    },
    {
      "id": "b1-society-4",
      "title": "Güvenli bir şehir",
      "names": [
        "Mert",
        "John"
      ],
      "lines": [
        {
          "en": "Is this city safe for tourists?",
          "tr": "Bu şehir turistler için güvenli mi?"
        },
        {
          "en": "Yes, there isn't much crime.",
          "tr": "Evet, pek suç yok."
        },
        {
          "en": "That is good news.",
          "tr": "Bu iyi bir haber."
        },
        {
          "en": "Also, residents are very friendly.",
          "tr": "Ayrıca, burada oturanlar çok arkadaş canlısı."
        },
        {
          "en": "It's worth visiting.",
          "tr": "Ziyaret etmeye değer."
        }
      ]
    },
    {
      "id": "b1-society-5",
      "title": "Seçim günü",
      "names": [
        "Elif",
        "Ozan"
      ],
      "lines": [
        {
          "en": "Did you vote yesterday?",
          "tr": "Dün oy verdin mi?"
        },
        {
          "en": "No, I didn't. I was very busy.",
          "tr": "Hayır, vermedim. Çok meşguldüm."
        },
        {
          "en": "But every citizen should vote!",
          "tr": "Ama her vatandaş oy vermeli!"
        },
        {
          "en": "I know. We need a good government.",
          "tr": "Biliyorum. İyi bir hükümete ihtiyacımız var."
        },
        {
          "en": "We need more jobs in our area.",
          "tr": "Bölgemizde daha çok iş lazım."
        }
      ]
    }
  ]
}
