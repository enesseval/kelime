  "stories": [
    {
      "id": "b1-wellbeing-1",
      "title": "A Football Accident",
      "title_tr": "Futbol kazası",
      "names": [
        "Ali"
      ],
      "lines": [
        {
          "en": "Ali is playing football. He injures his leg.",
          "tr": "Ali futbol oynuyor. Bacağından sakatlanıyor."
        },
        {
          "en": "It is an emergency. They call an ambulance.",
          "tr": "Bu bir acil durum. Ambulans çağırıyorlar."
        },
        {
          "en": "At the hospital, the doctor sees his injury.",
          "tr": "Hastanede doktor sakatlığına bakıyor."
        },
        {
          "en": "You need a small operation, Ali.",
          "tr": "Küçük bir ameliyat olman gerek, Ali."
        },
        {
          "en": "Don't be worried, it's not dangerous. Take it easy.",
          "tr": "Endişelenme, tehlikeli değil. Sakin ol."
        }
      ]
    },
    {
      "id": "b1-wellbeing-2",
      "title": "A Fresh Start",
      "title_tr": "Yeni bir başlangıç",
      "names": [
        "Ayşe"
      ],
      "lines": [
        {
          "en": "Ayşe, you look tired.",
          "tr": "Ayşe, yorgun görünüyorsun."
        },
        {
          "en": "I feel exhausted. I want to change my lifestyle.",
          "tr": "Çok yorgun hissediyorum. Yaşam tarzımı değiştirmek istiyorum."
        },
        {
          "en": "I'm trying to lose weight.",
          "tr": "Kilo vermeye çalışıyorum."
        },
        {
          "en": "I've given up chocolate recently.",
          "tr": "Geçenlerde çikolatayı bıraktım."
        },
        {
          "en": "Maybe you should quit your part-time job too.",
          "tr": "Belki yarı zamanlı işini de bırakmalısın."
        }
      ]
    },
    {
      "id": "b1-wellbeing-3",
      "title": "Stress at the Office",
      "title_tr": "Ofiste stres",
      "names": [
        "Burak"
      ],
      "lines": [
        {
          "en": "My new boss gives me a lot of stress.",
          "tr": "Yeni patronum bana çok stres yapıyor."
        },
        {
          "en": "There is too much pressure in the office.",
          "tr": "Ofiste çok fazla baskı var."
        },
        {
          "en": "You must find a good balance in life, Burak.",
          "tr": "Hayatta iyi bir denge bulmalısın, Burak."
        },
        {
          "en": "Mental rest is very important.",
          "tr": "Zihinsel dinlenme çok önemlidir."
        },
        {
          "en": "Go to the forest this weekend to relax.",
          "tr": "Rahatlamak için bu hafta sonu ormana git."
        }
      ]
    },
    {
      "id": "b1-wellbeing-4",
      "title": "At the Doctor's",
      "title_tr": "Doktorda",
      "names": [
        "Merve"
      ],
      "lines": [
        {
          "en": "I have a bad cough and a fever, doctor.",
          "tr": "Kötü bir öksürüğüm ve ateşim var, doktor."
        },
        {
          "en": "You have a fever. It is a bad symptom.",
          "tr": "Ateşin var. Bu kötü bir belirti."
        },
        {
          "en": "I will give you a prescription for your treatment.",
          "tr": "Tedavin için sana bir reçete vereceğim."
        },
        {
          "en": "You need some time to recover at home.",
          "tr": "Evde iyileşmek için biraz zamana ihtiyacın var."
        },
        {
          "en": "And don't smoke! It's bad for you.",
          "tr": "Ve sigara içme! Sana zararlı."
        }
      ]
    },
    {
      "id": "b1-wellbeing-5",
      "title": "Staying Fit",
      "title_tr": "Zinde kalmak",
      "names": [
        "Canan"
      ],
      "lines": [
        {
          "en": "Do you want to run with me today, Canan?",
          "tr": "Bugün benimle koşmak ister misin, Canan?"
        },
        {
          "en": "I'm not very fit. I am always tired.",
          "tr": "Pek fit değilim. Hep yorgunum."
        },
        {
          "en": "Physical exercise is really important.",
          "tr": "Fiziksel egzersiz gerçekten önemli."
        },
        {
          "en": "I know. I'm trying to cut down on sugar.",
          "tr": "Biliyorum. Şekeri azaltmaya çalışıyorum."
        },
        {
          "en": "I've given up fast food too.",
          "tr": "Fast food yemeyi de bıraktım."
        },
        {
          "en": "I agree with you. We must be healthy.",
          "tr": "Sana katılıyorum. Sağlıklı olmalıyız."
        }
      ]
    }
  ]
}
