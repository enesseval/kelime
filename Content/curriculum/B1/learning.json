  "stories": [
    {
      "id": "b1-learning-1",
      "title": "A New Course",
      "title_tr": "Yeni Kurs",
      "names": [
        "Emre",
        "English"
      ],
      "lines": [
        {
          "en": "Emre attends a new English course today.",
          "tr": "Emre bugün yeni bir İngilizce kursuna katılıyor."
        },
        {
          "en": "The teacher's native language is English.",
          "tr": "Öğretmenin ana dili İngilizce."
        },
        {
          "en": "Is this course suitable for me?",
          "tr": "Bu kurs benim için uygun mu?"
        },
        {
          "en": "Yes, the lessons are familiar.",
          "tr": "Evet, dersler tanıdık."
        },
        {
          "en": "I'm getting better at English.",
          "tr": "İngilizcede daha iyi oluyorum."
        },
        {
          "en": "But it takes time.",
          "tr": "Ama zaman alıyor."
        }
      ]
    },
    {
      "id": "b1-learning-2",
      "title": "Getting Ready for the Exam",
      "title_tr": "Sınava Hazırlık",
      "names": [
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Zeynep is revising for her exam.",
          "tr": "Zeynep sınavı için tekrar yapıyor."
        },
        {
          "en": "She wants to memorize the text.",
          "tr": "Metni ezberlemek istiyor."
        },
        {
          "en": "I can't concentrate. It is very noisy outside.",
          "tr": "Odaklanamıyorum. Dışarısı çok gürültülü."
        },
        {
          "en": "I keep forgetting the new vocabulary.",
          "tr": "Yeni kelimeleri sürekli unutuyorum."
        },
        {
          "en": "You need more motivation.",
          "tr": "Daha fazla motivasyona ihtiyacın var."
        },
        {
          "en": "Let's drink some coffee first.",
          "tr": "Önce biraz kahve içelim."
        }
      ]
    },
    {
      "id": "b1-learning-3",
      "title": "Speaking Fluently",
      "title_tr": "Akıcı Konuşma",
      "names": [
        "Ali",
        "German"
      ],
      "lines": [
        {
          "en": "Ali is fluent in German.",
          "tr": "Ali Almancada akıcı."
        },
        {
          "en": "His grammar is very good.",
          "tr": "Dil bilgisi çok iyi."
        },
        {
          "en": "However, his pronunciation is bad.",
          "tr": "Ancak telaffuzu kötü."
        },
        {
          "en": "What is your purpose for learning?",
          "tr": "Öğrenmekteki amacın ne?"
        },
        {
          "en": "I want to live abroad.",
          "tr": "Yurt dışında yaşamak istiyorum."
        },
        {
          "en": "Well, practice makes perfect.",
          "tr": "Eh, pratik mükemmelleştirir."
        }
      ]
    },
    {
      "id": "b1-learning-4",
      "title": "A Text Nobody Understood",
      "title_tr": "Anlaşılmayan Metin",
      "names": [
        "Anna",
        "Cem"
      ],
      "lines": [
        {
          "en": "Anna and Cem are studying together.",
          "tr": "Anna ve Cem birlikte ders çalışıyor."
        },
        {
          "en": "I don't understand this text.",
          "tr": "Bu metni anlamıyorum."
        },
        {
          "en": "Can you translate it for me?",
          "tr": "Benim için çevirebilir misin?"
        },
        {
          "en": "Can you explain it again?",
          "tr": "Tekrar açıklayabilir misin?"
        },
        {
          "en": "This is a good method to learn.",
          "tr": "Bu, öğrenmek için iyi bir yöntem."
        },
        {
          "en": "Yes, we are making good progress.",
          "tr": "Evet, iyi ilerleme kaydediyoruz."
        }
      ]
    },
    {
      "id": "b1-learning-5",
      "title": "The Certificate",
      "title_tr": "Sertifika",
      "names": [
        "Leyla"
      ],
      "lines": [
        {
          "en": "Leyla, are you aware of the exam tomorrow?",
          "tr": "Leyla, yarınki sınavın farkında mısın?"
        },
        {
          "en": "Yes, I am. I want to get the certificate.",
          "tr": "Evet, farkındayım. Sertifikayı almak istiyorum."
        },
        {
          "en": "My vocabulary is much better now.",
          "tr": "Kelime dağarcığım artık çok daha iyi."
        },
        {
          "en": "I'm getting better at reading too.",
          "tr": "Okumada da daha iyi oluyorum."
        },
        {
          "en": "It is worth taking the exam.",
          "tr": "Sınava girmeye değer."
        },
        {
          "en": "I agree with you.",
          "tr": "Sana katılıyorum."
        }
      ]
    }
  ],
  "names": [
    "English",
    "Turkish"
  ]
}
