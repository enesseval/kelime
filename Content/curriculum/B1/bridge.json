  "stories": [
    {
      "id": "b1-bridge-1",
      "title": "The Rumour",
      "title_tr": "Söylenti",
      "names": [
        "Mert",
        "Ali"
      ],
      "lines": [
        {
          "en": "Mert and Ali were at the office.",
          "tr": "Mert ve Ali ofisteydi."
        },
        {
          "en": "Did you hear the news about the manager?",
          "tr": "Müdür hakkındaki haberi duydun mu?"
        },
        {
          "en": "By the time I arrived, everyone knew it.",
          "tr": "Ben vardığımda herkes biliyordu."
        },
        {
          "en": "Apparently, he will retire soon.",
          "tr": "Görünüşe göre yakında emekli olacak."
        },
        {
          "en": "It is said that he bought a house on an island.",
          "tr": "Bir adada ev aldığı söyleniyor."
        },
        {
          "en": "I wish I had a lot of money like him.",
          "tr": "Keşke benim de onun gibi çok param olsaydı."
        },
        {
          "en": "If I were him, I would travel the planet.",
          "tr": "Onun yerinde olsaydım gezegeni gezerdim."
        }
      ]
    },
    {
      "id": "b1-bridge-2",
      "title": "The Witness",
      "title_tr": "Tanık",
      "names": [
        "Zeynep",
        "London"
      ],
      "lines": [
        {
          "en": "Zeynep witnessed a crime in London yesterday.",
          "tr": "Zeynep dün Londra'da bir suça tanık oldu."
        },
        {
          "en": "The police talked to her.",
          "tr": "Polis onunla konuştu."
        },
        {
          "en": "What did you see on the street?",
          "tr": "Sokakta ne gördünüz?"
        },
        {
          "en": "A suspect stole a bag from a tourist.",
          "tr": "Bir şüpheli bir turistten çanta çaldı."
        },
        {
          "en": "I doubt that he was a local resident.",
          "tr": "Yerel bir sakin olduğundan şüpheliyim."
        },
        {
          "en": "He told me that he needed help, then he ran.",
          "tr": "Bana yardıma ihtiyacı olduğunu söyledi, sonra koştu."
        },
        {
          "en": "Eventually, they found the bag.",
          "tr": "Sonunda çantayı buldular."
        }
      ]
    },
    {
      "id": "b1-bridge-3",
      "title": "Regret",
      "title_tr": "Pişmanlık",
      "names": [
        "Burak",
        "Selin"
      ],
      "lines": [
        {
          "en": "Burak regretted his big mistake.",
          "tr": "Burak büyük hatasından pişman oldu."
        },
        {
          "en": "Selin, I apologize.",
          "tr": "Selin, özür dilerim."
        },
        {
          "en": "I admit that I was jealous.",
          "tr": "Kıskanç olduğumu itiraf ediyorum."
        },
        {
          "en": "You pretended that you did not know!",
          "tr": "Bilmiyormuş gibi davrandın!"
        },
        {
          "en": "Whatever I say, you always disagree.",
          "tr": "Ne söylesem her zaman aynı fikirde değilsin."
        },
        {
          "en": "If I were you, I wouldn't forgive me.",
          "tr": "Senin yerinde olsaydım beni affetmezdim."
        },
        {
          "en": "I wish I had been more honest.",
          "tr": "Keşke daha dürüst olsaydım."
        }
      ]
    },
    {
      "id": "b1-bridge-4",
      "title": "The Empty Museum",
      "title_tr": "Boş Müze",
      "names": [
        "Ege",
        "Elif"
      ],
      "lines": [
        {
          "en": "The empty museum was a mystery.",
          "tr": "Boş müze bir gizemdi."
        },
        {
          "en": "Everyone claims that there is a dangerous animal inside.",
          "tr": "Herkes içeride tehlikeli bir hayvan olduğunu iddia ediyor."
        },
        {
          "en": "They say that it isn't safe.",
          "tr": "Güvenli olmadığını söylüyorlar."
        },
        {
          "en": "Ege was brave and walked inside.",
          "tr": "Ege cesurdu ve içeri yürüdü."
        },
        {
          "en": "He warned Elif.",
          "tr": "Elif'i uyardı."
        },
        {
          "en": "Do not come in! It is very cold.",
          "tr": "İçeri gelme! Çok soğuk."
        },
        {
          "en": "By the time she came in, he had found the answer: an open window!",
          "tr": "O içeri girdiğinde Ege cevabı bulmuştu: açık bir pencere!"
        }
      ]
    },
    {
      "id": "b1-bridge-5",
      "title": "The Result",
      "title_tr": "Sonuç",
      "names": [
        "Kaan"
      ],
      "lines": [
        {
          "en": "Kaan went very fast in his car on the coast.",
          "tr": "Kaan sahilde arabasıyla çok hızlı gitti."
        },
        {
          "en": "The consequence was a bad accident.",
          "tr": "Sonuç kötü bir kazaydı."
        },
        {
          "en": "I told him to go slowly.",
          "tr": "Ona yavaş gitmesini söyledim."
        },
        {
          "en": "It is said that he had no chance.",
          "tr": "Hiç şansı olmadığı söyleniyor."
        },
        {
          "en": "I wish I had stopped him.",
          "tr": "Keşke onu durdursaydım."
        },
        {
          "en": "Now we must accept the result.",
          "tr": "Artık sonucu kabul etmeliyiz."
        },
        {
          "en": "Imagine a planet with no accidents!",
          "tr": "Kazaların olmadığı bir gezegen hayal et!"
        }
      ]
    }
  ]
}
