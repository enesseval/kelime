  "stories": [
    {
      "id": "c1-language-1",
      "title": "Zor bir ders",
      "names": [
        "Ali",
        "Clark"
      ],
      "lines": [
        {
          "en": "Ali is a student. He listens to a lecture by Clark.",
          "tr": "Ali bir öğrenci. Clark'ın bir dersini dinliyor."
        },
        {
          "en": "I do not understand this academic jargon.",
          "tr": "Bu akademik jargonu anlamıyorum."
        },
        {
          "en": "Can you paraphrase it, please?",
          "tr": "Bunu kendi kelimelerinizle ifade edebilir misiniz, lütfen?"
        },
        {
          "en": "Let me rephrase that. The underlying theory is easy.",
          "tr": "Şöyle ifade edeyim. Temeldeki teori kolay."
        },
        {
          "en": "Your new message is very concise.",
          "tr": "Yeni mesajınız çok özlü."
        },
        {
          "en": "You must articulate your opinions in an academic register.",
          "tr": "Fikirlerinizi akademik bir üslupla açıkça ifade etmelisiniz."
        }
      ]
    },
    {
      "id": "c1-language-2",
      "title": "Londra'da yanlış anlama",
      "names": [
        "Zeynep",
        "London",
        "Ben"
      ],
      "lines": [
        {
          "en": "Zeynep lives in London. Ben speaks a local dialect.",
          "tr": "Zeynep Londra'da yaşıyor. Ben yerel bir lehçe konuşuyor."
        },
        {
          "en": "His colloquial words are difficult.",
          "tr": "Gündelik kelimeleri zor."
        },
        {
          "en": "Did he say that verbatim?",
          "tr": "Bunu kelimesi kelimesine mi söyledi?"
        },
        {
          "en": "Yes, but do not be so literal.",
          "tr": "Evet, ama bu kadar gerçek anlamıyla alma."
        },
        {
          "en": "It got lost in translation. I apologize.",
          "tr": "Çeviride kayboldu. Özür dilerim."
        }
      ]
    },
    {
      "id": "c1-language-3",
      "title": "Siyasi tartışma",
      "names": [
        "Maria"
      ],
      "lines": [
        {
          "en": "Maria watches a political debate on the internet.",
          "tr": "Maria internette siyasi bir tartışma izliyor."
        },
        {
          "en": "The eloquence of the candidate is obvious.",
          "tr": "Adayın hitabet yeteneği ortada."
        },
        {
          "en": "What does his comment imply?",
          "tr": "Onun yorumu ne ima ediyor?"
        },
        {
          "en": "His answer is quite nuanced.",
          "tr": "Cevabı oldukça incelikli."
        },
        {
          "en": "Political discourse is very sensitive.",
          "tr": "Siyasi söylem çok hassastır."
        }
      ]
    },
    {
      "id": "c1-language-4",
      "title": "İş görüşmesi",
      "names": [
        "Ayşe"
      ],
      "lines": [
        {
          "en": "Ayşe is at a job interview.",
          "tr": "Ayşe bir iş görüşmesinde."
        },
        {
          "en": "We need advanced language proficiency and fluency.",
          "tr": "İleri düzey dil yeterliliğine ve akıcılığa ihtiyacımız var."
        },
        {
          "en": "I am confident in my fluency.",
          "tr": "Akıcılığım konusunda kendime güveniyorum."
        },
        {
          "en": "To put it mildly, your tone was a little rude.",
          "tr": "Hafif tabirle, ses tonunuz biraz kabaydı."
        },
        {
          "en": "I'm at a loss for words. I apologize.",
          "tr": "Diyecek söz bulamıyorum. Özür dilerim."
        }
      ]
    },
    {
      "id": "c1-language-5",
      "title": "Gizli anlamlar",
      "names": [
        "Emre",
        "Sarah"
      ],
      "lines": [
        {
          "en": "Emre and Sarah read a novel.",
          "tr": "Emre ve Sarah bir roman okuyor."
        },
        {
          "en": "This idiom does not convey the message.",
          "tr": "Bu deyim mesajı iletmiyor."
        },
        {
          "en": "It has a bad connotation.",
          "tr": "Kötü bir yan anlamı var."
        },
        {
          "en": "You must read between the lines.",
          "tr": "Satır aralarını okumalısın."
        },
        {
          "en": "Now I understand the underlying nuance.",
          "tr": "Şimdi alttaki ince ayrıntıyı anlıyorum."
        }
      ]
    }
