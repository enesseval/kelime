  "stories": [
    {
      "id": "c1-ethics-1",
      "title": "Confidential Information",
      "title_tr": "Gizli Bilgi",
      "names": [
        "Leyla",
        "Murat"
      ],
      "lines": [
        {
          "en": "Did you read the new data?",
          "tr": "Yeni verileri okudun mu?"
        },
        {
          "en": "Yes, but it is confidential.",
          "tr": "Evet, ama gizli."
        },
        {
          "en": "I know. The underlying issue is substantial.",
          "tr": "Biliyorum. Altta yatan sorun ciddi."
        },
        {
          "en": "If we reveal it, it's a breach of our contract.",
          "tr": "Eğer açıklarsak, bu sözleşmemizin ihlalidir."
        },
        {
          "en": "True. A whistleblower could be arrested.",
          "tr": "Doğru. İhbarcı tutuklanabilir."
        },
        {
          "en": "We must maintain our integrity.",
          "tr": "Dürüstlüğümüzü korumalıyız."
        }
      ]
    },
    {
      "id": "c1-ethics-2",
      "title": "Camera Surveillance",
      "title_tr": "Kamera Gözetimi",
      "names": [
        "Ahmet",
        "Canan"
      ],
      "lines": [
        {
          "en": "The company wants surveillance in the office.",
          "tr": "Şirket ofiste gözetim istiyor."
        },
        {
          "en": "They need our explicit consent for that.",
          "tr": "Bunun için açık rızamıza ihtiyaçları var."
        },
        {
          "en": "I think it will infringe on our privacy.",
          "tr": "Bence bu gizliliğimizi ihlal edecek."
        },
        {
          "en": "In my opinion, it's a slippery slope.",
          "tr": "Bence bu tehlikeli bir gidişat."
        },
        {
          "en": "We should complain to the manager.",
          "tr": "Yöneticiye şikayet etmeliyiz."
        }
      ]
    },
    {
      "id": "c1-ethics-3",
      "title": "A Legal Loophole",
      "title_tr": "Hukuki Boşluk",
      "names": [
        "Emre"
      ],
      "lines": [
        {
          "en": "Emre is a lawyer. He found a loophole.",
          "tr": "Emre bir avukattır. Bir boşluk buldu."
        },
        {
          "en": "His client wants to avoid tax.",
          "tr": "Müvekkili vergi ödemekten kaçınmak istiyor."
        },
        {
          "en": "This method is unlawful.",
          "tr": "Bu yöntem yasadışıdır."
        },
        {
          "en": "But we can use the loophole!",
          "tr": "Ama boşluğu kullanabiliriz!"
        },
        {
          "en": "No, I will not do it. It's a matter of principle.",
          "tr": "Hayır, bunu yapmayacağım. Bu bir prensip meselesi."
        },
        {
          "en": "He is very ethical.",
          "tr": "Çok etik biri."
        }
      ]
    },
    {
      "id": "c1-ethics-4",
      "title": "In Court",
      "title_tr": "Mahkemede",
      "names": [
        "Zeynep",
        "London"
      ],
      "lines": [
        {
          "en": "Zeynep is at a court in London.",
          "tr": "Zeynep Londra'da bir mahkemede."
        },
        {
          "en": "The judge must be impartial.",
          "tr": "Hakim tarafsız olmalıdır."
        },
        {
          "en": "A witness gives testimony.",
          "tr": "Bir tanık ifade veriyor."
        },
        {
          "en": "Did you know the plan was unlawful?",
          "tr": "Planın yasadışı olduğunu biliyor muydunuz?"
        },
        {
          "en": "I didn't know the law.",
          "tr": "Yasayı bilmiyordum."
        },
        {
          "en": "Ignorance is no excuse. We will prosecute you.",
          "tr": "Bilmemek mazeret değildir. Size dava açacağız."
        },
        {
          "en": "The court has jurisdiction here.",
          "tr": "Mahkemenin burada yargı yetkisi var."
        }
      ]
    },
    {
      "id": "c1-ethics-5",
      "title": "Responsibility",
      "title_tr": "Sorumluluk",
      "names": [
        "Berk",
        "Aslı"
      ],
      "lines": [
        {
          "en": "Who is accountable for this online mistake?",
          "tr": "Bu çevrimiçi hatadan kim sorumlu?"
        },
        {
          "en": "The company has the liability.",
          "tr": "Hukuki sorumluluk şirkette."
        },
        {
          "en": "Will the court acquit them?",
          "tr": "Mahkeme onları beraat ettirecek mi?"
        },
        {
          "en": "It's a grey area. There is no obvious precedent.",
          "tr": "Bu gri bir alan. Bariz bir emsal yok."
        },
        {
          "en": "Their reason is not legitimate.",
          "tr": "Nedenleri meşru değil."
        },
        {
          "en": "Yes. The internet is a double-edged sword.",
          "tr": "Evet. İnternet iki ucu keskin bir kılıçtır."
        }
      ]
    }
  ]
}
