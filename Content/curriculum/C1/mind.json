  "stories": [
    {
      "id": "c1-mind-1",
      "title": "The Dilemma",
      "title_tr": "İkilem",
      "names": [
        "Ali",
        "Ozan"
      ],
      "lines": [
        {
          "en": "Ali and doctor Ozan are talking.",
          "tr": "Ali ve doktor Ozan konuşuyorlar."
        },
        {
          "en": "I feel anxious, but I can't put my finger on it.",
          "tr": "Endişeli hissediyorum ama adını tam koyamıyorum."
        },
        {
          "en": "I see. Tell me more.",
          "tr": "Anlıyorum. Bana daha fazlasını anlatın."
        },
        {
          "en": "I have a lot of anxiety.",
          "tr": "Çok fazla kaygım var."
        },
        {
          "en": "We can try cognitive therapy. Trust your intuition.",
          "tr": "Bilişsel terapiyi deneyebiliriz. Sezgilerinize güvenin."
        },
        {
          "en": "It is a good approach.",
          "tr": "Bu iyi bir yaklaşım."
        }
      ]
    },
    {
      "id": "c1-mind-2",
      "title": "Personalities",
      "title_tr": "Kişilikler",
      "names": [
        "Zeynep",
        "Clara",
        "London"
      ],
      "lines": [
        {
          "en": "Zeynep and Clara are flatmates in London.",
          "tr": "Zeynep ve Clara Londra'da ev arkadaşılar."
        },
        {
          "en": "Clara is an extrovert. She is an open book.",
          "tr": "Clara dışa dönük biri. İçi dışı birdir."
        },
        {
          "en": "Zeynep is an introvert. She is quite shy.",
          "tr": "Zeynep içe dönük biri. Oldukça utangaçtır."
        },
        {
          "en": "Let's go to a party tonight!",
          "tr": "Bu gece bir partiye gidelim!"
        },
        {
          "en": "I feel ambivalent about it. Parties are crowded.",
          "tr": "Bu konuda kararsız hissediyorum. Partiler kalabalık oluyor."
        },
        {
          "en": "Come on! It will be a good experience.",
          "tr": "Hadi ama! İyi bir deneyim olacak."
        }
      ]
    },
    {
      "id": "c1-mind-3",
      "title": "A Difficult Time",
      "title_tr": "Zor Dönem",
      "names": [
        "Mert",
        "David"
      ],
      "lines": [
        {
          "en": "Mert lost his job recently.",
          "tr": "Mert yakın zamanda işini kaybetti."
        },
        {
          "en": "How are you, Mert?",
          "tr": "Nasılsın, Mert?"
        },
        {
          "en": "I feel only apathy. I feel empty.",
          "tr": "Sadece kayıtsızlık hissediyorum. İçim bomboş."
        },
        {
          "en": "It's a rough patch. You have great resilience.",
          "tr": "Zor bir dönem. Harika bir toparlanma gücün var."
        },
        {
          "en": "Losing my job was a trauma for me.",
          "tr": "İşimi kaybetmek benim için bir travmaydı."
        },
        {
          "en": "You will overcome this soon.",
          "tr": "Bunu yakında aşacaksın."
        }
      ]
    },
    {
      "id": "c1-mind-4",
      "title": "Old Habits",
      "title_tr": "Eski Alışkanlıklar",
      "names": [
        "Selin"
      ],
      "lines": [
        {
          "en": "Selin has a compulsive tendency to spend money.",
          "tr": "Selin'in para harcamaya yönelik kompülsif bir eğilimi var."
        },
        {
          "en": "She bought an expensive bag yesterday.",
          "tr": "Dün pahalı bir çanta aldı."
        },
        {
          "en": "That was an impulsive decision.",
          "tr": "O fevri bir karardı."
        },
        {
          "en": "She knows she must be rational.",
          "tr": "Mantıklı olması gerektiğini biliyor."
        },
        {
          "en": "But she bought shoes today. Old habits die hard.",
          "tr": "Ama bugün de ayakkabı aldı. Huylu huyundan vazgeçmez."
        }
      ]
    },
    {
      "id": "c1-mind-5",
      "title": "Nostalgia and Perception",
      "title_tr": "Nostalji ve Algı",
      "names": [
        "Hasan",
        "Emma",
        "Paris"
      ],
      "lines": [
        {
          "en": "Hasan looks at old photos from Paris.",
          "tr": "Hasan Paris'ten eski fotoğraflara bakıyor."
        },
        {
          "en": "He feels nostalgia.",
          "tr": "Nostalji hissediyor."
        },
        {
          "en": "You were very insecure then.",
          "tr": "O zamanlar çok öz güvensizdin."
        },
        {
          "en": "I was in denial about my problems.",
          "tr": "Sorunlarımı inkâr ediyordum."
        },
        {
          "en": "Your perception of yourself was different.",
          "tr": "Kendine bakışın farklıydı."
        },
        {
          "en": "It's all in the mind. I am more confident now.",
          "tr": "Her şey kafada bitiyor. Artık kendime daha çok güveniyorum."
        }
      ]
    }
  ]
}
