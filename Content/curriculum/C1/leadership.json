  "stories": [
    {
      "id": "c1-leadership-1",
      "title": "A Hard Decision",
      "title_tr": "Zor Bir Karar",
      "names": [
        "Leyla",
        "John"
      ],
      "lines": [
        {
          "en": "Leyla and John work in an office.",
          "tr": "Leyla ve John bir ofiste çalışıyor."
        },
        {
          "en": "Is the new plan feasible, John?",
          "tr": "Yeni plan yapılabilir mi, John?"
        },
        {
          "en": "I doubt it. We must prioritize our budget.",
          "tr": "Şüpheliyim. Bütçemize öncelik vermeliyiz."
        },
        {
          "en": "Can we restructure the team instead?",
          "tr": "Onun yerine ekibi yeniden yapılandıramaz mıyız?"
        },
        {
          "en": "It's not my call. The manager decides.",
          "tr": "Benim kararım değil. Yönetici karar verir."
        },
        {
          "en": "Keep me in the loop, please.",
          "tr": "Beni haberdar et, lütfen."
        }
      ]
    },
    {
      "id": "c1-leadership-2",
      "title": "The Merger Meeting",
      "title_tr": "Birleşme Toplantısı",
      "names": [
        "Mehmet",
        "Sarah"
      ],
      "lines": [
        {
          "en": "Mehmet will oversee the new merger.",
          "tr": "Mehmet yeni birleşmeyi yönetecek."
        },
        {
          "en": "Every stakeholder is nervous about it.",
          "tr": "Her paydaş bu konuda gergin."
        },
        {
          "en": "We must streamline the plan.",
          "tr": "Planı sadeleştirmeliyiz."
        },
        {
          "en": "Yes, we have to be transparent.",
          "tr": "Evet, şeffaf olmak zorundayız."
        },
        {
          "en": "Let's touch base next week.",
          "tr": "Haftaya haberleşelim."
        },
        {
          "en": "Perfect. Let's take it from here.",
          "tr": "Harika. Gerisini biz hallederiz."
        }
      ]
    },
    {
      "id": "c1-leadership-3",
      "title": "The Workload",
      "title_tr": "İş Yükü",
      "names": [
        "Ayşe"
      ],
      "lines": [
        {
          "en": "Ayşe is a meticulous and diligent worker.",
          "tr": "Ayşe titiz ve gayretli bir çalışandır."
        },
        {
          "en": "However, her workload is very heavy.",
          "tr": "Ancak, iş yükü çok ağır."
        },
        {
          "en": "Every day is the same and tedious.",
          "tr": "Her gün aynı ve bıktırıcı."
        },
        {
          "en": "She is afraid of burnout.",
          "tr": "Tükenmişlikten korkuyor."
        },
        {
          "en": "I need a financial incentive.",
          "tr": "Mali bir teşvike ihtiyacım var."
        },
        {
          "en": "We must think outside the box to help her.",
          "tr": "Ona yardım etmek için kalıpların dışında düşünmeliyiz."
        }
      ]
    },
    {
      "id": "c1-leadership-4",
      "title": "A New Venture",
      "title_tr": "Yeni Girişim",
      "names": [
        "London",
        "Ali"
      ],
      "lines": [
        {
          "en": "Ali is in London for a big meeting.",
          "tr": "Ali büyük bir toplantı için Londra'da."
        },
        {
          "en": "They want to implement a new initiative.",
          "tr": "Yeni bir girişim uygulamak istiyorlar."
        },
        {
          "en": "Is it a viable idea?",
          "tr": "Uygulanabilir bir fikir mi?"
        },
        {
          "en": "Yes, but they must allocate more money.",
          "tr": "Evet, ama daha fazla para ayırmalılar."
        },
        {
          "en": "Accountability is the key to success.",
          "tr": "Başarının anahtarı hesap verebilirlik."
        },
        {
          "en": "I will oversee the start.",
          "tr": "Başlangıcı ben yöneteceğim."
        }
      ]
    },
    {
      "id": "c1-leadership-5",
      "title": "Managing Debt",
      "title_tr": "Borçları Yönetmek",
      "names": [
        "Kemal",
        "Emma"
      ],
      "lines": [
        {
          "en": "Kemal and Emma talk about their budget.",
          "tr": "Kemal ve Emma bütçeleri hakkında konuşuyor."
        },
        {
          "en": "We must consolidate our debts, Emma.",
          "tr": "Borçlarımızı birleştirmeliyiz, Emma."
        },
        {
          "en": "That is a feasible strategy.",
          "tr": "Bu yapılabilir bir strateji."
        },
        {
          "en": "It will make paying easier.",
          "tr": "Ödemeyi kolaylaştıracak."
        },
        {
          "en": "By and large, I agree with you.",
          "tr": "Genel olarak sana katılıyorum."
        },
        {
          "en": "Let's touch base next week about this.",
          "tr": "Haftaya bunun hakkında haberleşelim."
        }
      ]
    }
  ]
}
