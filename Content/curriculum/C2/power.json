  "stories": [
    {
      "id": "c2-power-1",
      "title": "The Campaign",
      "title_tr": "Kampanya",
      "names": [
        "Ali",
        "Deniz"
      ],
      "lines": [
        {
          "en": "Ali and Deniz plan a political campaign.",
          "tr": "Ali ve Deniz siyasi bir kampanya planlıyor."
        },
        {
          "en": "We need grassroots support for the candidate.",
          "tr": "Aday için taban desteğine ihtiyacımız var."
        },
        {
          "en": "Will he toe the party line?",
          "tr": "Parti çizgisine uyacak mı?"
        },
        {
          "en": "No, he is a demagogue.",
          "tr": "Hayır, o bir demagog."
        },
        {
          "en": "He uses populism and rhetoric.",
          "tr": "Popülizm ve retorik kullanıyor."
        },
        {
          "en": "This is a political hot potato!",
          "tr": "Bu çok hassas bir siyasi konu!"
        }
      ]
    },
    {
      "id": "c2-power-2",
      "title": "The Fall of the Government",
      "title_tr": "Hükümetin Düşüşü",
      "names": [
        "Leyla",
        "Ankara"
      ],
      "lines": [
        {
          "en": "Leyla lives in Ankara.",
          "tr": "Leyla Ankara'da yaşıyor."
        },
        {
          "en": "The incumbent government is very corrupt.",
          "tr": "Görevdeki hükümet çok yozlaşmış."
        },
        {
          "en": "They prevent dissent with censorship.",
          "tr": "Muhalefeti sansürle engelliyorlar."
        },
        {
          "en": "Is it an autocracy now?",
          "tr": "Artık bir otokrasi mi?"
        },
        {
          "en": "Yes, the authoritarian laws destroyed our democracy.",
          "tr": "Evet, otoriter yasalar demokrasimizi yok etti."
        },
        {
          "en": "There are rumours of a coup.",
          "tr": "Darbe söylentileri var."
        }
      ]
    },
    {
      "id": "c2-power-3",
      "title": "Secret Meetings",
      "title_tr": "Gizli Toplantılar",
      "names": [
        "Canan",
        "London"
      ],
      "lines": [
        {
          "en": "Canan works in London.",
          "tr": "Canan Londra'da çalışıyor."
        },
        {
          "en": "Rich families pull the strings there.",
          "tr": "Zengin aileler orada ipleri elinde tutuyor."
        },
        {
          "en": "It is an oligarchy.",
          "tr": "Bu bir oligarşi."
        },
        {
          "en": "They have clandestine meetings behind closed doors.",
          "tr": "Kapalı kapılar ardında gizli toplantılar yapıyorlar."
        },
        {
          "en": "They want global hegemony.",
          "tr": "Küresel hegemonya istiyorlar."
        },
        {
          "en": "Does the public know?",
          "tr": "Halk biliyor mu?"
        },
        {
          "en": "No, they just watch propaganda.",
          "tr": "Hayır, sadece propaganda izliyorlar."
        }
      ]
    },
    {
      "id": "c2-power-4",
      "title": "The Court Case",
      "title_tr": "Mahkeme Davası",
      "names": [
        "Emre",
        "Aylin"
      ],
      "lines": [
        {
          "en": "Emre and Aylin watch the news.",
          "tr": "Emre ve Aylin haberleri izliyor."
        },
        {
          "en": "Will parliament impeach the president?",
          "tr": "Meclis cumhurbaşkanını görevden alacak mı?"
        },
        {
          "en": "Yes, because of nepotism and fraud.",
          "tr": "Evet, adam kayırma ve dolandırıcılık yüzünden."
        },
        {
          "en": "The evidence is irrefutable.",
          "tr": "Kanıtlar çürütülemez."
        },
        {
          "en": "The vote is next week.",
          "tr": "Oylama gelecek hafta."
        },
        {
          "en": "A coalition government will start.",
          "tr": "Bir koalisyon hükümeti kurulacak."
        }
      ]
    },
    {
      "id": "c2-power-5",
      "title": "A Big Decision",
      "title_tr": "Büyük Karar",
      "names": [
        "Zeynep",
        "Izmir"
      ],
      "lines": [
        {
          "en": "Zeynep lives in Izmir.",
          "tr": "Zeynep İzmir'de yaşıyor."
        },
        {
          "en": "Tomorrow is the big referendum.",
          "tr": "Yarın büyük referandum var."
        },
        {
          "en": "Do we have sovereignty?",
          "tr": "Egemenliğimiz var mı?"
        },
        {
          "en": "Yes, every vote is pivotal.",
          "tr": "Evet, her oy çok önemli."
        },
        {
          "en": "Will partisan people change their opinions?",
          "tr": "Partizan insanlar fikirlerini değiştirecek mi?"
        },
        {
          "en": "It is very unlikely.",
          "tr": "Bu pek olası değil."
        }
      ]
    }
  ]
}
