      "lines": [
        {
          "en": "Zeynep is in Paris for a seminar.",
          "tr": "Zeynep bir seminer için Paris'te."
        },
        {
          "en": "She speaks eloquently about a famous painting.",
          "tr": "Ünlü bir tablo hakkında etkili konuşuyor."
        },
        {
          "en": "Her lucid story speaks volumes.",
          "tr": "Berrak hikayesi çok şey ifade ediyor."
        },
        {
          "en": "She shares a funny anecdote.",
          "tr": "Komik bir anekdot paylaşıyor."
        }
      ]
    },
    {
      "id": "c2-rhetoric-5",
      "title": "Retorik strateji",
      "names": [
        "John"
      ],
      "lines": [
        {
          "en": "John uses a lot of clichés.",
          "tr": "John çok fazla klişe kullanır."
        },
        {
          "en": "His latest claim is hyperbole.",
          "tr": "Son iddiası abartı."
        },
        {
          "en": "To call it a mistake is an understatement.",
          "tr": "Buna hata demek hafif kalır."
        },
        {
          "en": "What are you insinuating?",
          "tr": "Ne ima etmeye çalışıyorsun?"
        },
        {
          "en": "It is just a rhetorical strategy.",
          "tr": "Bu sadece retorik bir strateji."
        },
        {
          "en": "He alludes to a big crisis.",
          "tr": "Büyük bir krize üstü kapalı değiniyor."
        }
