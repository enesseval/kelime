  "stories": [
    {
      "id": "c2-literature-1",
      "title": "Yeni Bir Kitap",
      "names": [
        "Ayşe",
        "Tom"
      ],
      "lines": [
        {
          "en": "Ayşe and Tom read a new book.",
          "tr": "Ayşe ve Tom yeni bir kitap okuyor."
        },
        {
          "en": "Is it in prose?",
          "tr": "Düzyazı mı?"
        },
        {
          "en": "No, it is written in verse. It is very lyrical.",
          "tr": "Hayır, manzum yazılmış. Oldukça lirik."
        },
        {
          "en": "Read the first stanza.",
          "tr": "İlk kıtayı oku."
        },
        {
          "en": "It is a poignant sonnet.",
          "tr": "Dokunaklı bir sone."
        },
        {
          "en": "This is a page-turner!",
          "tr": "Bu çok sürükleyici!"
        }
      ]
    },
    {
      "id": "c2-literature-2",
      "title": "Londra'da Okuma",
      "names": [
        "Ali",
        "London"
      ],
      "lines": [
        {
          "en": "Ali is in London. He is reading a long novel.",
          "tr": "Ali Londra'da. Uzun bir roman okuyor."
        },
        {
          "en": "The protagonist is a traditional archetype.",
          "tr": "Başkarakter geleneksel bir arketip."
        },
        {
          "en": "What about the antagonist?",
          "tr": "Peki ya kötü karakter?"
        },
        {
          "en": "The antagonist is very strange.",
          "tr": "Kötü karakter çok tuhaf."
        },
        {
          "en": "The narrator is omniscient.",
          "tr": "Anlatıcı her şeyi biliyor."
        },
        {
          "en": "The author uses subtle foreshadowing. The plot thickens!",
          "tr": "Yazar ince sezdirmeler kullanıyor. İşler iyice karışıyor!"
        }
      ]
    },
    {
      "id": "c2-literature-3",
      "title": "Derin Duygular",
      "names": [
        "Zeynep",
        "Maria"
      ],
      "lines": [
        {
          "en": "Zeynep, do you like this poem?",
          "tr": "Zeynep, bu şiiri beğendin mi?"
        },
        {
          "en": "Yes, Maria. The language is sublime.",
          "tr": "Evet Maria. Dili ulvi bir güzellikte."
        },
        {
          "en": "It is an elegy for a lost village.",
          "tr": "Kayıp bir köy için yazılmış bir ağıt."
        },
        {
          "en": "A profound melancholy is evident. It elicits pathos.",
          "tr": "Derin bir hüzün göze çarpıyor. Acıma duygusu uyandırıyor."
        },
        {
          "en": "Is it a pastiche?",
          "tr": "Bir pastiş mi?"
        },
        {
          "en": "No, the narrative is genuine.",
          "tr": "Hayır, anlatı sahici."
        }
      ]
    },
    {
      "id": "c2-literature-4",
      "title": "Eski Bir Roman",
      "names": [
        "Cem",
        "Paris"
      ],
      "lines": [
        {
          "en": "Cem buys an old book in Paris.",
          "tr": "Cem Paris'te eski bir kitap alıyor."
        },
        {
          "en": "At first, the story is whimsical and funny.",
          "tr": "Başlarda hikaye uçuk kaçık ve komik."
        },
        {
          "en": "Then, grotesque images appear.",
          "tr": "Sonra grotesk imgeler beliriyor."
        },
        {
          "en": "The narrative gets very macabre.",
          "tr": "Anlatı çok ürkütücü bir hal alıyor."
        },
        {
          "en": "It is an epic journey.",
          "tr": "Bu destansı bir yolculuk."
        },
        {
          "en": "The denouement is tragic.",
          "tr": "Çözüm bölümü trajik."
        }
      ]
    },
    {
      "id": "c2-literature-5",
      "title": "Yazar ve Dostu",
      "names": [
        "David",
        "Elif"
      ],
      "lines": [
        {
          "en": "David, your new book is an epic!",
          "tr": "David, yeni kitabın tam bir destan!"
        },
        {
          "en": "I am grateful, Elif. In it, I explore my childhood.",
          "tr": "Minnettarım Elif. Kitapta çocukluğumu irdeliyorum."
        },
        {
          "en": "It reads like a novel.",
          "tr": "Bir roman gibi okunuyor."
        },
        {
          "en": "I use some poetic licence.",
          "tr": "Biraz sanatsal özgürlük kullanıyorum."
        },
        {
          "en": "The cover is plain, but don't judge a book by its cover.",
          "tr": "Kapağı sade ama görünüşe aldanmamak lazım."
        },
        {
          "en": "Needless to say, it is a masterpiece.",
          "tr": "Söylemeye gerek yok, bu bir şaheser."
        }
      ]
    }
  ]
}
