  "stories": [
    {
      "id": "c2-justice-1",
      "title": "Dava Başlıyor",
      "names": [
        "Arthur",
        "Maria"
      ],
      "lines": [
        {
          "en": "Arthur is the plaintiff.",
          "tr": "Arthur davacı."
        },
        {
          "en": "Maria is the defendant.",
          "tr": "Maria ise sanık."
        },
        {
          "en": "The litigation is very expensive.",
          "tr": "Dava süreci çok pahalı."
        },
        {
          "en": "Maria has a good alibi.",
          "tr": "Maria'nın iyi bir mazereti var."
        },
        {
          "en": "She wants an acquittal.",
          "tr": "Beraat istiyor."
        }
      ]
    },
    {
      "id": "c2-justice-2",
      "title": "Ağır Suç",
      "names": [
        "Clark",
        "Tom"
      ],
      "lines": [
        {
          "en": "Judge Clark will adjudicate the trial.",
          "tr": "Yargıç Clark davayı hükme bağlayacak."
        },
        {
          "en": "Tom's crime is a felony.",
          "tr": "Tom'un suçu ağır bir suç."
        },
        {
          "en": "He is guilty beyond reasonable doubt.",
          "tr": "Makul şüphenin ötesinde suçlu."
        },
        {
          "en": "He is culpable.",
          "tr": "O kusurlu."
        },
        {
          "en": "The police will keep him in custody.",
          "tr": "Polis onu gözaltında tutacak."
        }
      ]
    },
    {
      "id": "c2-justice-3",
      "title": "Katı Karar",
      "names": [
        "Sara"
      ],
      "lines": [
        {
          "en": "Sara reads the indictment.",
          "tr": "Sara iddianameyi okuyor."
        },
        {
          "en": "The statute is very strict.",
          "tr": "Kanun çok katı."
        },
        {
          "en": "The tribunal does not offer clemency.",
          "tr": "Mahkeme af teklif etmiyor."
        },
        {
          "en": "It is a punitive decision.",
          "tr": "Bu cezalandırıcı bir karar."
        },
        {
          "en": "They want a deterrent.",
          "tr": "Bir caydırıcı istiyorlar."
        }
      ]
    },
    {
      "id": "c2-justice-4",
      "title": "Kanunun Lafzı",
      "names": [
        "John",
        "Anna"
      ],
      "lines": [
        {
          "en": "John committed perjury.",
          "tr": "John yalan yere yemin etti."
        },
        {
          "en": "But he got off scot-free!",
          "tr": "Ama ceza almadan kurtuldu!"
        },
        {
          "en": "The lawyer respects the letter of the law.",
          "tr": "Avukat kanunun lafzına saygı duyuyor."
        },
        {
          "en": "Nobody is above the law.",
          "tr": "Hiç kimse kanunların üstünde değildir."
        },
        {
          "en": "Anna will appeal the verdict.",
          "tr": "Anna kararı temyiz edecek."
        }
      ]
    },
    {
      "id": "c2-justice-5",
      "title": "Sonuç",
      "names": [
        "David",
        "London"
      ],
      "lines": [
        {
          "en": "David is in London.",
          "tr": "David Londra'da."
        },
        {
          "en": "The new video will exonerate him.",
          "tr": "Yeni video onu temize çıkaracak."
        },
        {
          "en": "The judge issued an injunction.",
          "tr": "Yargıç bir mahkeme emri çıkardı."
        },
        {
          "en": "He is not guilty.",
          "tr": "O suçlu değil."
        },
        {
          "en": "The court is lenient today.",
          "tr": "Mahkeme bugün hoşgörülü."
        },
        {
          "en": "Now David wants justice.",
          "tr": "Şimdi David adalet istiyor."
        }
      ]
    }
  ]
}
