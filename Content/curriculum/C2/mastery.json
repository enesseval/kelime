  "stories": [
    {
      "id": "c2-mastery-1",
      "title": "Londra Sanatı",
      "names": [
        "Emma",
        "London",
        "Ali"
      ],
      "lines": [
        {
          "en": "Emma is in London.",
          "tr": "Emma Londra'da."
        },
        {
          "en": "This is the quintessential London museum.",
          "tr": "Bu, tam bir Londra müzesi."
        },
        {
          "en": "Ali, look! They juxtapose old and new paintings.",
          "tr": "Ali, bak! Eski ve yeni tabloları yan yana koyuyorlar."
        },
        {
          "en": "Meeting you here was serendipity.",
          "tr": "Seninle burada karşılaşmak tamamen şanstı."
        },
        {
          "en": "Yes! And the free coffee is the icing on the cake.",
          "tr": "Evet! Bedava kahve de cabası."
        },
        {
          "en": "I love it. Moments like this are ephemeral.",
          "tr": "Bunu seviyorum. Böyle anlar geçicidir."
        }
      ]
    },
    {
      "id": "c2-mastery-2",
      "title": "Anlaşılmaz Kitap",
      "names": [
        "Ahmet"
      ],
      "lines": [
        {
          "en": "Ahmet has an idiosyncratic method.",
          "tr": "Ahmet'in kendine özgü bir yöntemi var."
        },
        {
          "en": "His new book is very esoteric.",
          "tr": "Yeni kitabı oldukça anlaşılması zor."
        },
        {
          "en": "His friend hits the nail on the head: 'It is too esoteric.'",
          "tr": "Arkadaşı tam üstüne basıyor: 'Fazla anlaşılmaz.'"
        },
        {
          "en": "The blue cover looks incongruous.",
          "tr": "Mavi kapak uyumsuz duruyor."
        },
        {
          "en": "But the ending leaves an ineffable feeling.",
          "tr": "Ama sonu tarif edilemez bir his bırakıyor."
        }
      ]
    },
    {
      "id": "c2-mastery-3",
      "title": "Yeni Politika",
      "names": [
        "Istanbul",
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Istanbul has labyrinthine streets.",
          "tr": "İstanbul'un labirent gibi sokakları var."
        },
        {
          "en": "Traffic is a perennial problem here.",
          "tr": "Trafik burada sürekli bir sorun."
        },
        {
          "en": "Zeynep is sanguine about the new policy.",
          "tr": "Zeynep yeni politika hakkında iyimser."
        },
        {
          "en": "I will leave no stone unturned to find a solution.",
          "tr": "Bir çözüm bulmak için elimden geleni ardına koymayacağım."
        },
        {
          "en": "That is a quixotic goal, Zeynep!",
          "tr": "Bu hayalperest bir hedef, Zeynep!"
        }
      ]
    },
    {
      "id": "c2-mastery-4",
      "title": "Kariyer Zirvesi",
      "names": [
        "David"
      ],
      "lines": [
        {
          "en": "David is at the zenith of his career.",
          "tr": "David kariyerinin zirvesinde."
        },
        {
          "en": "Last year was the nadir.",
          "tr": "Geçen yıl en alt noktaydı."
        },
        {
          "en": "His mother feels a vicarious joy at his success.",
          "tr": "Annesi onun başarısını dolaylı yoldan yaşıyor."
        },
        {
          "en": "He visits his parents once in a blue moon.",
          "tr": "Ailesini ayda yılda bir ziyaret eder."
        },
        {
          "en": "But they are always proud.",
          "tr": "Ama her zaman gurur duyuyorlar."
        }
      ]
    },
    {
      "id": "c2-mastery-5",
      "title": "Sergi",
      "names": [
        "Elif"
      ],
      "lines": [
        {
          "en": "Elif meticulously planned the exhibition.",
          "tr": "Elif sergiyi titizlikle planladı."
        },
        {
          "en": "The enigmatic artist is finally here.",
          "tr": "Gizemli sanatçı nihayet burada."
        },
        {
          "en": "Her new painting is very cathartic.",
          "tr": "Yeni tablosu insanı çok rahatlatıyor."
        },
        {
          "en": "It is both traditional and contemporary.",
          "tr": "Hem geleneksel hem çağdaş."
        },
        {
          "en": "Yes, we have the best of both worlds.",
          "tr": "Evet, ikisinin de en iyi yanı bir arada."
        }
      ]
    }
  ]
