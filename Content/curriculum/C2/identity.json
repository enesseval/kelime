  "stories": [
    {
      "id": "c2-identity-1",
      "title": "Moving Away",
      "title_tr": "Taşınma",
      "names": [
        "Ali",
        "London"
      ],
      "lines": [
        {
          "en": "Ali is an immigrant in London.",
          "tr": "Ali Londra'da bir göçmen."
        },
        {
          "en": "On the face of it, the city is very cosmopolitan.",
          "tr": "İlk bakışta şehir çok kozmopolit."
        },
        {
          "en": "But he feels alienation.",
          "tr": "Ama yabancılaşma hissediyor."
        },
        {
          "en": "He is a fish out of water.",
          "tr": "O sudan çıkmış bir balık."
        },
        {
          "en": "He looks for the Turkish diaspora.",
          "tr": "Türk diasporasını arıyor."
        },
        {
          "en": "Solidarity is important for him.",
          "tr": "Dayanışma onun için önemli."
        }
      ]
    },
    {
      "id": "c2-identity-2",
      "title": "Old and New",
      "title_tr": "Eski ve Yeni",
      "names": [
        "Zeynep",
        "Istanbul"
      ],
      "lines": [
        {
          "en": "Gentrification is changing Zeynep's neighbourhood.",
          "tr": "Soylulaştırma Zeynep'in mahallesini değiştiriyor."
        },
        {
          "en": "It is becoming too homogeneous.",
          "tr": "Fazlasıyla homojenleşiyor."
        },
        {
          "en": "We lose the local subculture.",
          "tr": "Yerel alt kültürü kaybediyoruz."
        },
        {
          "en": "It stands to reason that people are angry.",
          "tr": "İnsanların kızgın olması gayet doğal."
        },
        {
          "en": "We need to protect our heritage.",
          "tr": "Mirasımızı korumamız gerek."
        },
        {
          "en": "We must bridge the gap between old and new neighbours.",
          "tr": "Eski ve yeni komşular arasındaki uçurumu kapatmalıyız."
        }
      ]
    },
    {
      "id": "c2-identity-3",
      "title": "A New Job",
      "title_tr": "Yeni İş",
      "names": [
        "Emre",
        "Berlin"
      ],
      "lines": [
        {
          "en": "Emre works in Berlin.",
          "tr": "Emre Berlin'de çalışıyor."
        },
        {
          "en": "The company has an egalitarian culture.",
          "tr": "Şirketin eşitlikçi bir kültürü var."
        },
        {
          "en": "He doesn't like assimilation.",
          "tr": "Asimilasyondan hoşlanmıyor."
        },
        {
          "en": "He is proud of his ethnicity.",
          "tr": "Etnik kökeniyle gurur duyuyor."
        },
        {
          "en": "When in Rome…",
          "tr": "Girdiğin köyün adetine uy."
        },
        {
          "en": "He tries to adapt.",
          "tr": "Uyum sağlamaya çalışıyor."
        }
      ]
    },
    {
      "id": "c2-identity-4",
      "title": "Changing Times",
      "title_tr": "Değişen Zamanlar",
      "names": [
        "Ayşe",
        "Paris"
      ],
      "lines": [
        {
          "en": "Ayşe studies the zeitgeist.",
          "tr": "Ayşe zamanın ruhunu inceliyor."
        },
        {
          "en": "She visits a secular community.",
          "tr": "Laik bir topluluğu ziyaret ediyor."
        },
        {
          "en": "They have an interesting ritual.",
          "tr": "İlginç bir ritüelleri var."
        },
        {
          "en": "Is it a taboo?",
          "tr": "Bu bir tabu mu?"
        },
        {
          "en": "No, it is just folklore.",
          "tr": "Hayır, sadece folklor."
        },
        {
          "en": "Paris is a melting pot.",
          "tr": "Paris, kültürlerin kaynaştığı bir yer."
        }
      ]
    },
    {
      "id": "c2-identity-5",
      "title": "Overcoming Prejudice",
      "title_tr": "Önyargıyı Aşmak",
      "names": [
        "Defne",
        "Toronto"
      ],
      "lines": [
        {
          "en": "Defne lives in Toronto.",
          "tr": "Defne Toronto'da yaşıyor."
        },
        {
          "en": "Xenophobia often grows from a stereotype.",
          "tr": "Yabancı düşmanlığı çoğu zaman bir kalıp yargıdan doğar."
        },
        {
          "en": "Pluralism can ameliorate this.",
          "tr": "Çoğulculuk bunu iyileştirebilir."
        },
        {
          "en": "Her parochial colleague does not understand.",
          "tr": "Dar görüşlü meslektaşı anlamıyor."
        },
        {
          "en": "She helps him.",
          "tr": "Ona yardım ediyor."
        },
        {
          "en": "Now everyone in the office feels at home.",
          "tr": "Artık ofisteki herkes kendini evinde hissediyor."
        }
      ]
    }
  ]
}
