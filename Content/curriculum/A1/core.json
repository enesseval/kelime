 "stories": [
  {
   "id": "a1-core-1",
   "title": "Tanışma",
   "names": [
    "Zeynep",
    "Sam",
    "Turkey",
    "London",
    "Turkish"
   ],
   "lines": [
    {
     "en": "Hello! My name is Zeynep. I'm from Turkey.",
     "tr": "Merhaba! Benim adım Zeynep. Türkiyeliyim."
    },
    {
     "en": "Hi, Zeynep. I'm Sam. Nice to meet you.",
     "tr": "Selam Zeynep. Ben Sam. Memnun oldum."
    },
    {
     "en": "Nice to meet you too. Where are you from?",
     "tr": "Ben de memnun oldum. Nerelisin?"
    },
    {
     "en": "I'm from London. I live here now.",
     "tr": "Londralıyım. Şimdi burada yaşıyorum."
    },
    {
     "en": "Do you speak Turkish?",
     "tr": "Türkçe konuşuyor musun?"
    },
    {
     "en": "No, sorry. I don't understand Turkish.",
     "tr": "Hayır, kusura bakma. Türkçe anlamıyorum."
    }
   ]
  },
  {
   "id": "a1-core-2",
   "title": "Yeni arkadaş",
   "names": [
    "Ece",
    "Mert"
   ],
   "lines": [
    {
     "en": "This is my friend Ece. She works here.",
     "tr": "Bu benim arkadaşım Ece. Burada çalışıyor."
    },
    {
     "en": "Hello, Ece! How are you?",
     "tr": "Merhaba Ece! Nasılsın?"
    },
    {
     "en": "I'm fine, thanks. And you, Mert?",
     "tr": "İyiyim, teşekkürler. Ya sen Mert?"
    },
    {
     "en": "I'm very happy today. I have a new friend!",
     "tr": "Bugün çok mutluyum. Yeni bir arkadaşım var!"
    },
    {
     "en": "Have a good day!",
     "tr": "İyi günler!"
    },
    {
     "en": "See you!",
     "tr": "Görüşürüz!"
    }
   ]
  }
 ]
}
