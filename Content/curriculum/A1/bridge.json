 "stories": [
  {
   "id": "a1-bridge-1",
   "title": "Dünkü gezi",
   "names": [
    "Ahmet",
    "İzmir",
    "Turkey"
   ],
   "lines": [
    {
     "en": "Ahmet is from Turkey. Yesterday he was in İzmir.",
     "tr": "Ahmet Türkiyeli. Dün İzmir'deydi."
    },
    {
     "en": "What did you do yesterday?",
     "tr": "Dün ne yaptın?"
    },
    {
     "en": "Yesterday I went to the park.",
     "tr": "Dün parka gittim."
    },
    {
     "en": "I saw my friends there.",
     "tr": "Orada arkadaşlarımı gördüm."
    },
    {
     "en": "The weather was very good.",
     "tr": "Hava çok güzeldi."
    },
    {
     "en": "We had a nice time.",
     "tr": "Güzel vakit geçirdik."
    }
   ]
  },
  {
   "id": "a1-bridge-2",
   "title": "Gelecek hafta",
   "names": [
    "Zeynep",
    "Ankara"
   ],
   "lines": [
    {
     "en": "Zeynep lives in Ankara. She has a train ticket.",
     "tr": "Zeynep Ankara'da yaşıyor. Tren bileti var."
    },
    {
     "en": "Next week I'm going to travel.",
     "tr": "Önümüzdeki hafta seyahat edeceğim."
    },
    {
     "en": "I'm going to visit my grandmother.",
     "tr": "Büyükannemi ziyaret edeceğim."
    },
    {
     "en": "Are you going to stay at a hotel?",
     "tr": "Otelde mi kalacaksın?"
    },
    {
     "en": "No, I'm going to stay at her house.",
     "tr": "Hayır, onun evinde kalacağım."
    },
    {
     "en": "Zeynep is very happy.",
     "tr": "Zeynep çok mutlu."
    }
   ]
  },
  {
   "id": "a1-bridge-3",
   "title": "Geçen yılın tatili",
   "names": [
    "Kerem",
    "Mert"
   ],
   "lines": [
    {
     "en": "Last year Kerem and his friend Mert had a holiday.",
     "tr": "Geçen yıl Kerem ve arkadaşı Mert tatile çıktı."
    },
    {
     "en": "They went to the beach.",
     "tr": "Plaja gittiler."
    },
    {
     "en": "The sun was hot and the water was blue.",
     "tr": "Güneş sıcaktı, deniz masmaviydi."
    },
    {
     "en": "Before lunch, they swam.",
     "tr": "Öğle yemeğinden önce yüzdüler."
    },
    {
     "en": "After lunch, they sat and read their books.",
     "tr": "Öğle yemeğinden sonra oturup kitaplarını okudular."
    },
    {
     "en": "They were very happy.",
     "tr": "Çok mutluydular."
    }
   ]
  },
  {
   "id": "a1-bridge-4",
   "title": "İki gün önce",
   "names": [
    "Selin",
    "İstanbul"
   ],
   "lines": [
    {
     "en": "Two days ago Selin was in İstanbul.",
     "tr": "İki gün önce Selin İstanbul'daydı."
    },
    {
     "en": "She went to a market.",
     "tr": "Bir pazara gitti."
    },
    {
     "en": "She saw cheap shoes and a red dress.",
     "tr": "Ucuz ayakkabılar ve kırmızı bir elbise gördü."
    },
    {
     "en": "What did you buy?",
     "tr": "Ne aldın?"
    },
    {
     "en": "I bought a small bag.",
     "tr": "Küçük bir çanta aldım."
    },
    {
     "en": "The price was good.",
     "tr": "Fiyatı iyiydi."
    }
   ]
  },
  {
   "id": "a1-bridge-5",
   "title": "Yarın",
   "names": [
    "Murat",
    "English"
   ],
   "lines": [
    {
     "en": "Murat is a young man. He speaks English.",
     "tr": "Murat genç bir adam. İngilizce konuşuyor."
    },
    {
     "en": "Today he is at home.",
     "tr": "Bugün evde."
    },
    {
     "en": "What is your plan for tomorrow?",
     "tr": "Yarın için planın ne?"
    },
    {
     "en": "Tomorrow I'm going to work.",
     "tr": "Yarın çalışacağım."
    },
    {
     "en": "After work I'm going to watch a film.",
     "tr": "İşten sonra film izleyeceğim."
    },
    {
     "en": "I'm happy.",
     "tr": "Mutluyum."
    }
   ]
  }
 ]
}
