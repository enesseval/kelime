  "stories": [
    {
      "id": "a2-health-1",
      "title": "At the Doctor's",
      "title_tr": "Doktorda",
      "names": [
        "Ahmet",
        "İzmir"
      ],
      "lines": [
        {
          "en": "Ahmet is ill. He goes to a hospital in İzmir.",
          "tr": "Ahmet hasta. İzmir'de bir hastaneye gidiyor."
        },
        {
          "en": "Hello. I need an appointment with a doctor.",
          "tr": "Merhaba. Bir doktordan randevu almam gerek."
        },
        {
          "en": "What is the problem? – My stomach hurts.",
          "tr": "Sorun nedir? – Midem ağrıyor."
        },
        {
          "en": "How long have you had it?",
          "tr": "Ne zamandır var?"
        },
        {
          "en": "Since yesterday. And I have a fever.",
          "tr": "Dünden beri. Bir de ateşim var."
        },
        {
          "en": "Please sit and wait here. A nurse will help.",
          "tr": "Lütfen buraya oturun ve bekleyin. Bir hemşire yardımcı olacak."
        },
        {
          "en": "Thank you. – Get well soon!",
          "tr": "Teşekkür ederim. – Geçmiş olsun!"
        }
      ]
    },
    {
      "id": "a2-health-2",
      "title": "At the Pharmacy",
      "title_tr": "Eczanede",
      "names": [
        "Selin",
        "London"
      ],
      "lines": [
        {
          "en": "Selin is in a pharmacy in London.",
          "tr": "Selin Londra'da bir eczanede."
        },
        {
          "en": "Hello. Can you help me? I have a bad headache.",
          "tr": "Merhaba. Yardım edebilir misiniz? Kötü bir baş ağrım var."
        },
        {
          "en": "Do you also have a cough? – Yes, a little.",
          "tr": "Öksürüğün de var mı? – Evet, biraz."
        },
        {
          "en": "Take this medicine with water.",
          "tr": "Bu ilacı suyla alın."
        },
        {
          "en": "You should rest in bed today.",
          "tr": "Bugün yatakta dinlenmelisin."
        },
        {
          "en": "Thank you for the good advice.",
          "tr": "İyi tavsiye için teşekkürler."
        }
      ]
    },
    {
      "id": "a2-health-3",
      "title": "A Dentist Appointment",
      "title_tr": "Dişçi randevusu",
      "names": [
        "Emre",
        "Ankara"
      ],
      "lines": [
        {
          "en": "Emre lives in Ankara. He has a bad tooth.",
          "tr": "Emre Ankara'da yaşıyor. Dişi fena durumda."
        },
        {
          "en": "My tooth hurts! I can't eat anything.",
          "tr": "Dişim ağrıyor! Hiçbir şey yiyemiyorum."
        },
        {
          "en": "You should visit a dentist today.",
          "tr": "Bugün bir diş hekimine gitmelisin."
        },
        {
          "en": "I need an appointment for this afternoon.",
          "tr": "Bu öğleden sonra için bir randevu almam gerek."
        },
        {
          "en": "The dentist can see you at two.",
          "tr": "Diş hekimi seni saat ikide görebilir."
        },
        {
          "en": "That is fine. I hope the pain will stop.",
          "tr": "Bu iyi. Umarım ağrı geçer."
        }
      ]
    },
    {
      "id": "a2-health-4",
      "title": "A Small Accident",
      "title_tr": "Küçük bir kaza",
      "names": [
        "Kerem",
        "Bursa"
      ],
      "lines": [
        {
          "en": "Kerem had a small accident in Bursa.",
          "tr": "Kerem Bursa'da küçük bir kaza geçirdi."
        },
        {
          "en": "He was running and he hurt his arm.",
          "tr": "Koşarken kolunu incitti."
        },
        {
          "en": "Does your back hurt too? – No, just my arm.",
          "tr": "Sırtın da ağrıyor mu? – Hayır, sadece kolum."
        },
        {
          "en": "The nurse looks at his arm and his back.",
          "tr": "Hemşire koluna ve sırtına bakıyor."
        },
        {
          "en": "It's not bad. You should rest.",
          "tr": "Kötü değil. Dinlenmelisin."
        },
        {
          "en": "Get well soon, Kerem!",
          "tr": "Geçmiş olsun, Kerem!"
        }
      ]
    },
    {
      "id": "a2-health-5",
      "title": "Healthy Living",
      "title_tr": "Sağlıklı yaşam",
      "names": [
        "Banu",
        "Cem"
      ],
      "lines": [
        {
          "en": "Banu and Cem speak in the park.",
          "tr": "Banu ile Cem parkta konuşuyor."
        },
        {
          "en": "I feel tired every morning. Can you give me advice?",
          "tr": "Her sabah yorgun hissediyorum. Bana tavsiye verir misin?"
        },
        {
          "en": "You should choose a healthy diet and drink water.",
          "tr": "Sağlıklı beslenmeyi seçmeli ve su içmelisin."
        },
        {
          "en": "Do you exercise? – Not really.",
          "tr": "Spor yapıyor musun? – Pek değil."
        },
        {
          "en": "Exercise is good for your body. Walk with me!",
          "tr": "Egzersiz vücuduna iyi gelir. Benimle yürü!"
        },
        {
          "en": "That's a good idea. I will start today.",
          "tr": "İyi fikir. Bugün başlayacağım."
        }
      ]
    }
  ]
}
