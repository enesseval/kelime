  "stories": [
    {
      "id": "a2-people-1",
      "title": "A New Friend",
      "title_tr": "Yeni arkadaş",
      "names": [
        "Ali",
        "Cem"
      ],
      "lines": [
        {
          "en": "Cem has a new friend from his work.",
          "tr": "Cem'in iş yerinden yeni bir arkadaşı var."
        },
        {
          "en": "What is he like?",
          "tr": "Nasıl biridir?"
        },
        {
          "en": "He is very funny and clever. We laugh a lot.",
          "tr": "Çok komik ve zeki biri. Çok gülüyoruz."
        },
        {
          "en": "Does he have glasses?",
          "tr": "Gözlük takıyor mu?"
        },
        {
          "en": "Yes, and he has a short beard.",
          "tr": "Evet, bir de kısa bir sakalı var."
        },
        {
          "en": "We get on well.",
          "tr": "İyi anlaşıyoruz."
        }
      ]
    },
    {
      "id": "a2-people-2",
      "title": "The Big Party",
      "title_tr": "Büyük parti",
      "names": [
        "Ali",
        "Sara"
      ],
      "lines": [
        {
          "en": "Today is Ali's birthday.",
          "tr": "Bugün Ali'nin doğum günü."
        },
        {
          "en": "Happy birthday! Here is a small gift for you.",
          "tr": "İyi ki doğdun! Bu senin için küçük bir hediye."
        },
        {
          "en": "Thank you, Sara! You are always so kind.",
          "tr": "Teşekkürler, Sara! Her zaman çok naziksin."
        },
        {
          "en": "Did you invite many guests to your party?",
          "tr": "Partine çok misafir davet ettin mi?"
        },
        {
          "en": "Yes, thirty people are coming to celebrate.",
          "tr": "Evet, kutlamak için otuz kişi geliyor."
        },
        {
          "en": "Let's go into the garden and dance.",
          "tr": "Bahçeye çıkıp dans edelim."
        }
      ]
    },
    {
      "id": "a2-people-3",
      "title": "A Wedding Invitation",
      "title_tr": "Düğün daveti",
      "names": [
        "Ece",
        "Leo",
        "Mert"
      ],
      "lines": [
        {
          "en": "Leo is at a café with his partner, Mert.",
          "tr": "Leo, partneri Mert ile bir kafede."
        },
        {
          "en": "Their friend Ece comes to their table.",
          "tr": "Arkadaşları Ece masalarına geliyor."
        },
        {
          "en": "Would you like to come to our wedding?",
          "tr": "Düğünümüze gelmek ister misin?"
        },
        {
          "en": "Our wedding is next year.",
          "tr": "Düğünümüz gelecek yıl."
        },
        {
          "en": "Congratulations! That is great!",
          "tr": "Tebrikler! Harika!"
        },
        {
          "en": "They have a very good relationship.",
          "tr": "Çok iyi bir ilişkileri var."
        }
      ]
    },
    {
      "id": "a2-people-4",
      "title": "Someone Famous in the Café",
      "title_tr": "Kafede ünlü biri",
      "names": [
        "Emma",
        "Hakan",
        "London"
      ],
      "lines": [
        {
          "en": "Hakan and Emma sit near the window in London.",
          "tr": "Hakan ve Emma, Londra'da cam kenarında oturuyorlar."
        },
        {
          "en": "Look at that man with the long black hair.",
          "tr": "Şu uzun siyah saçlı adama bak."
        },
        {
          "en": "I think he is a famous doctor from Turkey.",
          "tr": "Sanırım o, Türkiye'den ünlü bir doktor."
        },
        {
          "en": "Is he polite or rude?",
          "tr": "Kibar biri midir, kaba mı?"
        },
        {
          "en": "He is shy, but really friendly.",
          "tr": "Çekingen biridir ama gerçekten çok cana yakındır."
        },
        {
          "en": "Let's bring him a cup of coffee.",
          "tr": "Ona bir fincan kahve götürelim."
        }
      ]
    },
    {
      "id": "a2-people-5",
      "title": "Sunday",
      "title_tr": "Pazar günü",
      "names": [
        "Selin",
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Selin and her sister Zeynep are at home.",
          "tr": "Selin ve kız kardeşi Zeynep evdeler."
        },
        {
          "en": "Are you tired today?",
          "tr": "Bugün yorgun musun?"
        },
        {
          "en": "Yes, I feel lazy and I want to stay in bed.",
          "tr": "Evet, canım hiçbir şey yapmak istemiyor, yatakta kalmak istiyorum."
        },
        {
          "en": "We can make some tea and watch a funny film.",
          "tr": "Biraz çay yapıp komik bir film izleyebiliriz."
        },
        {
          "en": "That's a good idea! We always get on well.",
          "tr": "İyi fikir! Zaten hep iyi anlaşırız."
        }
      ]
    }
  ]
}
