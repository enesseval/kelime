  "stories": [
    {
      "id": "a2-work-1",
      "title": "A Job Interview",
      "title_tr": "İş görüşmesi",
      "names": [
        "Selin",
        "London"
      ],
      "lines": [
        {
          "en": "Selin has a job interview in London today.",
          "tr": "Selin'in bugün Londra'da iş görüşmesi var."
        },
        {
          "en": "What do you do?",
          "tr": "Ne iş yapıyorsunuz?"
        },
        {
          "en": "I work as a manager in a small company.",
          "tr": "Küçük bir şirkette yönetici olarak çalışıyorum."
        },
        {
          "en": "Do you have experience with customers?",
          "tr": "Müşterilerle deneyiminiz var mı?"
        },
        {
          "en": "Yes, I have five years of work experience.",
          "tr": "Evet, beş yıllık iş tecrübem var."
        },
        {
          "en": "We want to employ you.",
          "tr": "Sizi işe almak istiyoruz."
        },
        {
          "en": "The salary is very good and Selin is happy.",
          "tr": "Maaş çok iyi ve Selin mutlu."
        }
      ]
    },
    {
      "id": "a2-work-2",
      "title": "A Meeting at the Office",
      "title_tr": "Ofiste toplantı",
      "names": [
        "Kerem",
        "John"
      ],
      "lines": [
        {
          "en": "Kerem and John work in the same office.",
          "tr": "Kerem ve John aynı ofiste çalışıyorlar."
        },
        {
          "en": "Can we meet on Tuesday?",
          "tr": "Salı günü buluşabilir miyiz?"
        },
        {
          "en": "I am busy right now, but Tuesday is good.",
          "tr": "Şu an meşgulüm ama salı uygun."
        },
        {
          "en": "Can you arrange a meeting room for our team?",
          "tr": "Ekibimiz için bir toplantı odası ayarlar mısın?"
        },
        {
          "en": "Yes, I will arrange it before lunch.",
          "tr": "Evet, öğle yemeğinden önce ayarlarım."
        },
        {
          "en": "The boss will also come to our meeting.",
          "tr": "Patron da toplantımıza gelecek."
        }
      ]
    },
    {
      "id": "a2-work-3",
      "title": "The Report and the Deadline",
      "title_tr": "Rapor ve son teslim",
      "names": [
        "Banu",
        "Paris"
      ],
      "lines": [
        {
          "en": "Banu works for a big company in Paris.",
          "tr": "Banu Paris'te büyük bir şirkette çalışıyor."
        },
        {
          "en": "Her colleague asks for the new report.",
          "tr": "İş arkadaşı yeni raporu istiyor."
        },
        {
          "en": "The deadline is tomorrow afternoon.",
          "tr": "Son teslim tarihi yarın öğleden sonra."
        },
        {
          "en": "I must finish this report today.",
          "tr": "Bu raporu bugün bitirmeliyim."
        },
        {
          "en": "I'll send you an email with the report.",
          "tr": "Sana raporla birlikte bir e-posta atarım."
        },
        {
          "en": "That's a good idea. Thank you, Banu!",
          "tr": "Bu iyi bir fikir. Teşekkürler Banu!"
        }
      ]
    },
    {
      "id": "a2-work-4",
      "title": "A Part-Time Job",
      "title_tr": "Yarı zamanlı iş",
      "names": [
        "Emre",
        "İzmir"
      ],
      "lines": [
        {
          "en": "Emre lives in İzmir and needs money.",
          "tr": "Emre İzmir'de yaşıyor ve paraya ihtiyacı var."
        },
        {
          "en": "He finds a part-time job in a busy café.",
          "tr": "Yoğun bir kafede yarı zamanlı bir iş buluyor."
        },
        {
          "en": "I work as a waiter three days a week.",
          "tr": "Haftada üç gün garson olarak çalışıyorum."
        },
        {
          "en": "He finds an important new skill every day.",
          "tr": "Her gün önemli yeni bir beceri öğreniyor."
        },
        {
          "en": "He earns good money for his family.",
          "tr": "Ailesi için iyi para kazanıyor."
        },
        {
          "en": "The customers like him very much.",
          "tr": "Müşteriler onu çok seviyor."
        }
      ]
    },
    {
      "id": "a2-work-5",
      "title": "A Message from the Manager",
      "title_tr": "Müdürün mesajı",
      "names": [
        "Zeynep",
        "David",
        "Ankara"
      ],
      "lines": [
        {
          "en": "Zeynep and David work in an office in Ankara.",
          "tr": "Zeynep ve David Ankara'da bir ofiste çalışıyorlar."
        },
        {
          "en": "Can we meet on Wednesday morning?",
          "tr": "Çarşamba sabahı buluşabilir miyiz?"
        },
        {
          "en": "I'm busy right now because I have a meeting.",
          "tr": "Şu an meşgulüm çünkü bir toplantım var."
        },
        {
          "en": "Is the new report ready for the boss?",
          "tr": "Patron için yeni rapor hazır mı?"
        },
        {
          "en": "It is almost ready. I'll send you an email.",
          "tr": "Neredeyse hazır. Sana bir e-posta atarım."
        },
        {
          "en": "Great! Our manager can read it before Friday.",
          "tr": "Harika! Müdürümüz cumadan önce onu okuyabilir."
        }
      ]
    }
  ],
  "names": [
    "English"
  ]
}
