  "stories": [
    {
      "id": "a2-core-1",
      "title": "İzmir'de bir akşam",
      "names": [
        "Selin",
        "Kerem",
        "İzmir"
      ],
      "lines": [
        {
          "en": "Selin and Kerem are in İzmir for a holiday.",
          "tr": "Selin ile Kerem tatil için İzmir'deler."
        },
        {
          "en": "Where should we go this evening?",
          "tr": "Bu akşam nereye gidelim?"
        },
        {
          "en": "Could you choose a good café, please?",
          "tr": "İyi bir kafe seçebilir misin, lütfen?"
        },
        {
          "en": "I think the café near the beach is the best.",
          "tr": "Bence plajın yanındaki kafe en iyisi."
        },
        {
          "en": "That's a good idea. I am hungry.",
          "tr": "İyi fikir. Karnım acıktı."
        },
        {
          "en": "Me too. Let's leave now because it is late.",
          "tr": "Ben de. Geç olduğu için hemen çıkalım."
        }
      ]
    },
    {
      "id": "a2-core-2",
      "title": "Londra treni",
      "names": [
        "Emre",
        "London"
      ],
      "lines": [
        {
          "en": "Emre waited for the train to London.",
          "tr": "Emre Londra trenini bekledi."
        },
        {
          "en": "He wanted to buy a ticket, but he made a mistake.",
          "tr": "Bir bilet almak istedi ama bir hata yaptı."
        },
        {
          "en": "He couldn't find his bag with his money.",
          "tr": "İçinde parası olan çantasını bulamadı."
        },
        {
          "en": "Could you help me, please?",
          "tr": "Bana yardım edebilir misiniz, lütfen?"
        },
        {
          "en": "A woman found his bag and gave it to him.",
          "tr": "Bir kadın çantasını buldu ve ona verdi."
        },
        {
          "en": "Emre was happy and took the train.",
          "tr": "Emre mutlu oldu ve trene bindi."
        }
      ]
    },
    {
      "id": "a2-core-3",
      "title": "Hafta sonu planı",
      "names": [
        "Burak",
        "Deniz"
      ],
      "lines": [
        {
          "en": "Can we play football tomorrow?",
          "tr": "Yarın futbol oynayabilir miyiz?"
        },
        {
          "en": "It depends. The weather was worse yesterday.",
          "tr": "Duruma göre. Dün hava daha kötüydü."
        },
        {
          "en": "What do you mean? Is it raining?",
          "tr": "Ne demek istiyorsun? Yağmur mu yağıyor?"
        },
        {
          "en": "No, but it is almost cold enough to snow.",
          "tr": "Hayır ama hava neredeyse kar yağacak kadar soğuk."
        },
        {
          "en": "I don't think so. I hope it will be warm.",
          "tr": "Sanmıyorum. Umarım hava ılık olur."
        },
        {
          "en": "Maybe we can decide in the morning.",
          "tr": "Belki sabah karar verebiliriz."
        }
      ]
    }
  ]
}
