  "stories": [
    {
      "id": "a2-bridge-1",
      "title": "A Strange Day in the Park",
      "title_tr": "Parkta tuhaf bir gün",
      "names": [
        "London",
        "Selim"
      ],
      "lines": [
        {
          "en": "Selim was walking in London when it started to rain.",
          "tr": "Selim Londra'da yürüyordu ki yağmur başladı."
        },
        {
          "en": "Suddenly, he saw a black bag under a tree.",
          "tr": "Birden bir ağacın altında siyah bir çanta gördü."
        },
        {
          "en": "A strange man ran to the bag and took it.",
          "tr": "Tuhaf bir adam çantaya koştu ve onu aldı."
        },
        {
          "en": "Stop! Did you steal that bag?",
          "tr": "Dur! O çantayı sen mi çaldın?"
        },
        {
          "en": "The man was afraid and left the bag.",
          "tr": "Adam korktu ve çantayı bıraktı."
        },
        {
          "en": "Selim called the police.",
          "tr": "Selim polisi aradı."
        },
        {
          "en": "In the end, the police gave the bag to the woman.",
          "tr": "Sonunda polis çantayı kadına verdi."
        }
      ]
    },
    {
      "id": "a2-bridge-2",
      "title": "The Lost Passport",
      "title_tr": "Kayıp pasaport",
      "names": [
        "Rome",
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Zeynep was waiting at the airport in Rome.",
          "tr": "Zeynep Roma'da havaalanında bekliyordu."
        },
        {
          "en": "First, she bought a coffee and some water.",
          "tr": "Önce bir kahve ve biraz su aldı."
        },
        {
          "en": "Then, she looked inside her bag.",
          "tr": "Sonra çantasının içine baktı."
        },
        {
          "en": "Oh no! Did I lose my passport?",
          "tr": "Olamaz! Pasaportumu mu kaybettim?"
        },
        {
          "en": "She was very worried during the flight delay.",
          "tr": "Uçuş rötarlı olduğu sırada çok endişelendi."
        },
        {
          "en": "Luckily, a friendly waiter ran to her table with it.",
          "tr": "Neyse ki kibar bir garson masasına pasaportla koştu."
        },
        {
          "en": "Thank you! I was so worried!",
          "tr": "Teşekkürler! Çok endişelenmiştim!"
        }
      ]
    },
    {
      "id": "a2-bridge-3",
      "title": "Plans and the Weather",
      "title_tr": "Hava durumu planı",
      "names": [
        "Murat",
        "Bursa",
        "Emre"
      ],
      "lines": [
        {
          "en": "Murat and Emre were planning a trip near Bursa.",
          "tr": "Murat ve Emre Bursa yakınlarında bir gezi planlıyordu."
        },
        {
          "en": "The news says a heavy storm is coming tomorrow.",
          "tr": "Haberlerde yarın şiddetli bir fırtına geleceği söyleniyor."
        },
        {
          "en": "If it rains, we'll visit the museum.",
          "tr": "Yağmur yağarsa müzeyi gezeriz."
        },
        {
          "en": "Walking in the forest during a storm is dangerous.",
          "tr": "Fırtına sırasında ormanda yürümek tehlikeli."
        },
        {
          "en": "That's a good idea. The forest is dangerous in a storm.",
          "tr": "İyi fikir. Fırtınada orman tehlikeli."
        },
        {
          "en": "Finally, they decided on the museum.",
          "tr": "Sonunda müzede karar kıldılar."
        }
      ]
    },
    {
      "id": "a2-bridge-4",
      "title": "The Broken Cup",
      "title_tr": "Kırılan fincan",
      "names": [
        "Selin",
        "Canan"
      ],
      "lines": [
        {
          "en": "Selin was very angry in the kitchen.",
          "tr": "Selin mutfakta çok kızgındı."
        },
        {
          "en": "What happened? Why are you angry?",
          "tr": "Ne oldu? Neden kızgınsın?"
        },
        {
          "en": "I was washing the dishes when I broke my grandmother's cup.",
          "tr": "Bulaşıkları yıkarken büyükannemin fincanını kırdım."
        },
        {
          "en": "Unfortunately, it was an old family memory.",
          "tr": "Maalesef eski bir aile hatırasıydı."
        },
        {
          "en": "It's OK. We can fix it together.",
          "tr": "Sorun değil. Birlikte tamir edebiliriz."
        },
        {
          "en": "Selin was surprised and happy.",
          "tr": "Selin şaşırdı ve sevindi."
        }
      ]
    },
    {
      "id": "a2-bridge-5",
      "title": "The Bird's Adventure",
      "title_tr": "Kuşun macerası",
      "names": [
        "Kerem",
        "İzmir"
      ],
      "lines": [
        {
          "en": "Kerem lives in a quiet village near İzmir.",
          "tr": "Kerem İzmir yakınlarında sakin bir köyde yaşıyor."
        },
        {
          "en": "One night, he heard something strange downstairs.",
          "tr": "Bir gece aşağıda tuhaf bir şey duydu."
        },
        {
          "en": "He was afraid, but he walked down slowly.",
          "tr": "Korkmuştu ama yavaşça aşağı indi."
        },
        {
          "en": "His little bird was eating bread on the table.",
          "tr": "Küçük kuşu masada ekmek yiyordu."
        },
        {
          "en": "I don't believe it! Bad bird!",
          "tr": "İnanmıyorum! Yaramaz kuş!"
        },
        {
          "en": "Kerem laughed and told his sister the funny story.",
          "tr": "Kerem güldü ve bu komik hikâyeyi kız kardeşine anlattı."
        }
      ]
    }
  ],
