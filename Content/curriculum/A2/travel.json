  "stories": [
    {
      "id": "a2-travel-1",
      "title": "First Day at the Hotel",
      "title_tr": "Otelde ilk gün",
      "names": [
        "Selin",
        "Rome"
      ],
      "lines": [
        {
          "en": "Selin is on holiday in Rome.",
          "tr": "Selin Roma'da tatilde."
        },
        {
          "en": "Hello, I have a reservation.",
          "tr": "Merhaba, rezervasyonum var."
        },
        {
          "en": "Hello! Here is the key to your room.",
          "tr": "Merhaba! İşte odanızın anahtarı."
        },
        {
          "en": "Is breakfast included?",
          "tr": "Kahvaltı dahil mi?"
        },
        {
          "en": "Yes, breakfast is from seven to ten.",
          "tr": "Evet, kahvaltı yediden ona kadar."
        },
        {
          "en": "The room has a beautiful city view.",
          "tr": "Odanın güzel bir şehir manzarası var."
        },
        {
          "en": "This luxury hotel is really nice.",
          "tr": "Bu lüks otel gerçekten çok hoş."
        }
      ]
    },
    {
      "id": "a2-travel-2",
      "title": "A Delay at the Airport",
      "title_tr": "Havalimanında rötar",
      "names": [
        "Emre",
        "London"
      ],
      "lines": [
        {
          "en": "Emre arrives at the airport for his flight to London.",
          "tr": "Emre, Londra uçuşu için havalimanına varıyor."
        },
        {
          "en": "His suitcase is very heavy, so he carries it slowly.",
          "tr": "Bavulu çok ağır, bu yüzden onu yavaşça taşıyor."
        },
        {
          "en": "A woman looks at his passport.",
          "tr": "Bir kadın onun pasaportuna bakıyor."
        },
        {
          "en": "I am sorry, the flight is delayed.",
          "tr": "Üzgünüm, uçuş rötarlı."
        },
        {
          "en": "There is bad weather and rain.",
          "tr": "Kötü hava ve yağmur var."
        },
        {
          "en": "Emre decides to wait in a café.",
          "tr": "Emre bir kafede beklemeye karar veriyor."
        }
      ]
    },
    {
      "id": "a2-travel-3",
      "title": "Buying a Ticket at the Station",
      "title_tr": "Garda bilet almak",
      "names": [
        "Kerem",
        "Izmir"
      ],
      "lines": [
        {
          "en": "Kerem is at the train station in Izmir.",
          "tr": "Kerem İzmir'deki tren garında."
        },
        {
          "en": "Single or return?",
          "tr": "Tek yön mü, gidiş-dönüş mü?"
        },
        {
          "en": "One return ticket, please.",
          "tr": "Bir gidiş-dönüş bilet, lütfen."
        },
        {
          "en": "What time does it leave?",
          "tr": "Saat kaçta kalkıyor?"
        },
        {
          "en": "It leaves at three from platform two.",
          "tr": "Üçte, ikinci perondan kalkıyor."
        },
        {
          "en": "Run, or you will miss the train!",
          "tr": "Koş, yoksa treni kaçıracaksın!"
        }
      ]
    },
    {
      "id": "a2-travel-4",
      "title": "A Museum Visit",
      "title_tr": "Müze gezisi",
      "names": [
        "Mert",
        "Paris"
      ],
      "lines": [
        {
          "en": "Mert travels abroad to Paris as a tourist.",
          "tr": "Mert turist olarak yurt dışına, Paris'e seyahat ediyor."
        },
        {
          "en": "A friendly guide shows him an old museum.",
          "tr": "Güler yüzlü bir rehber ona eski bir müzeyi gezdiriyor."
        },
        {
          "en": "There are many foreign tourists here.",
          "tr": "Burada pek çok yabancı turist var."
        },
        {
          "en": "Mert buys a small souvenir for his sister.",
          "tr": "Mert kız kardeşi için küçük bir hediyelik eşya alıyor."
        },
        {
          "en": "He takes a photo from the garden.",
          "tr": "Bahçeden bir fotoğraf çekiyor."
        },
        {
          "en": "This was his best journey.",
          "tr": "Bu onun en güzel yolculuğuydu."
        }
      ]
    },
    {
      "id": "a2-travel-5",
      "title": "Getting Ready to Go Home",
      "title_tr": "Eve dönüş hazırlığı",
      "names": [
        "Zeynep"
      ],
      "lines": [
        {
          "en": "Zeynep needs to pack her luggage today.",
          "tr": "Zeynep'in bugün bagajını toplaması gerekiyor."
        },
        {
          "en": "Her big bag is on the bedroom floor.",
          "tr": "Büyük çantası yatak odasının yerinde."
        },
        {
          "en": "Tomorrow she will fly home.",
          "tr": "Yarın uçakla eve dönecek."
        },
        {
          "en": "Her plane will land in the afternoon.",
          "tr": "Uçağı öğleden sonra inecek."
        },
        {
          "en": "She is tired but very happy.",
          "tr": "Yorgun ama çok mutlu."
        }
      ]
    }
  ],
  "names": [
    "London"
  ]
}
