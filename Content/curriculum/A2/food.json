  "stories": [
    {
      "id": "a2-food-1",
      "title": "Akşam yemeği",
      "names": [
        "Mert",
        "Selin",
        "İzmir"
      ],
      "lines": [
        {
          "en": "Mert and Selin walk into a restaurant in İzmir.",
          "tr": "Mert ile Selin İzmir'de bir restorana girerler."
        },
        {
          "en": "A table for two, please.",
          "tr": "İki kişilik bir masa, lütfen."
        },
        {
          "en": "Are you ready to order?",
          "tr": "Sipariş vermeye hazır mısınız?"
        },
        {
          "en": "What do you recommend?",
          "tr": "Ne tavsiye edersiniz?"
        },
        {
          "en": "The fish is fresh today.",
          "tr": "Balık bugün taze."
        },
        {
          "en": "I'm allergic to fish. I'd like chicken and rice.",
          "tr": "Balığa alerjim var. Tavuk ve pilav alayım."
        },
        {
          "en": "They eat dinner and it's delicious!",
          "tr": "Akşam yemeğini yerler ve çok lezzetlidir!"
        }
      ]
    },
    {
      "id": "a2-food-2",
      "title": "Vejetaryen misafir",
      "names": [
        "Kerem",
        "Sarah",
        "London"
      ],
      "lines": [
        {
          "en": "Sarah lives in London and visits her friend Kerem.",
          "tr": "Sarah Londra'da yaşar ve arkadaşı Kerem'i ziyaret eder."
        },
        {
          "en": "Do you eat meat or chicken?",
          "tr": "Et ya da tavuk yer misin?"
        },
        {
          "en": "No, I'm a vegetarian.",
          "tr": "Hayır, ben vejetaryenim."
        },
        {
          "en": "Kerem makes a hot vegetable dish with rice.",
          "tr": "Kerem pilavlı sıcak bir sebze yemeği yapar."
        },
        {
          "en": "He brings fresh bread and a big salad too.",
          "tr": "Taze ekmek ve büyük bir salata da getirir."
        },
        {
          "en": "Sarah tastes the dish.",
          "tr": "Sarah yemeğin tadına bakar."
        },
        {
          "en": "It's delicious!",
          "tr": "Çok lezzetli!"
        }
      ]
    },
    {
      "id": "a2-food-3",
      "title": "Kolay bir tarif",
      "names": [
        "Emre",
        "Bursa"
      ],
      "lines": [
        {
          "en": "Emre wants to cook dinner at his home in Bursa.",
          "tr": "Emre Bursa'daki evinde akşam yemeği pişirmek ister."
        },
        {
          "en": "His mother gave him an easy soup recipe.",
          "tr": "Annesi ona kolay bir çorba tarifi verdi."
        },
        {
          "en": "First, he buys fresh vegetables.",
          "tr": "Önce taze sebze alıyor."
        },
        {
          "en": "Boil them in water.",
          "tr": "Onları suda haşlayın."
        },
        {
          "en": "Is it spicy? I don't think so.",
          "tr": "Baharatlı mı? Sanmıyorum."
        },
        {
          "en": "He tastes the hot soup and he is very happy.",
          "tr": "Sıcak çorbanın tadına bakar ve çok mutlu olur."
        }
      ]
    },
    {
      "id": "a2-food-4",
      "title": "Pazar alışverişi",
      "names": [
        "Fatma",
        "Antalya"
      ],
      "lines": [
        {
          "en": "Fatma goes to the open market in Antalya.",
          "tr": "Fatma Antalya'da açık pazara gider."
        },
        {
          "en": "She wants to buy fresh fruit and vegetables.",
          "tr": "Taze meyve ve sebze almak istiyor."
        },
        {
          "en": "How much is one kilo of fruit?",
          "tr": "Bir kilo meyve ne kadar?"
        },
        {
          "en": "It's cheap today.",
          "tr": "Bugün ucuz."
        },
        {
          "en": "She buys two kilos of fruit and leaves the market.",
          "tr": "İki kilo meyve alır ve pazardan ayrılır."
        },
        {
          "en": "Now she can bake a cake for dessert.",
          "tr": "Artık tatlı için bir kek pişirebilir."
        }
      ]
    },
    {
      "id": "a2-food-5",
      "title": "Yeni bir masa",
      "names": [
        "Burak",
        "Cem",
        "Ankara"
      ],
      "lines": [
        {
          "en": "Burak and Cem are hungry after work in Ankara.",
          "tr": "Burak ile Cem Ankara'da iş çıkışı açtır."
        },
        {
          "en": "They find a nice restaurant near the station.",
          "tr": "İstasyonun yakınında güzel bir restoran bulurlar."
        },
        {
          "en": "A table for two, please.",
          "tr": "İki kişilik bir masa, lütfen."
        },
        {
          "en": "The waiter brings the menu.",
          "tr": "Garson menüyü getirir."
        },
        {
          "en": "Are you ready to order?",
          "tr": "Sipariş vermeye hazır mısınız?"
        },
        {
          "en": "We want meat, rice, and fresh bread.",
          "tr": "Et, pilav ve taze ekmek istiyoruz."
        },
        {
          "en": "The food comes and it's delicious!",
          "tr": "Yemek geliyor ve çok lezzetli!"
        }
      ]
    }
  ]
}
