  "stories": [
    {
      "id": "b2-society-1",
      "title": "Siyasi tartışma",
      "names": [
        "Ali",
        "Hasan"
      ],
      "lines": [
        {
          "en": "Did you watch the political debate yesterday?",
          "tr": "Dün siyasi tartışmayı izledin mi?"
        },
        {
          "en": "Yes. The government policy is an issue.",
          "tr": "Evet. Hükümet politikası bir sorun."
        },
        {
          "en": "In terms of money, it is a disaster.",
          "tr": "Para açısından bu bir felaket."
        },
        {
          "en": "There's a growing concern about poverty.",
          "tr": "Yoksulluk konusunda endişe artıyor."
        },
        {
          "en": "The point is, they should help the poor.",
          "tr": "Mesele şu ki, yoksullara yardım etmeliler."
        },
        {
          "en": "That's easier said than done.",
          "tr": "Söylemesi kolay."
        },
        {
          "en": "Nevertheless, it is their job.",
          "tr": "Yine de, bu onların işi."
        }
      ]
    },
    {
      "id": "b2-society-2",
      "title": "Öğrenci protestosu",
      "names": [
        "Zeynep",
        "Canan"
      ],
      "lines": [
        {
          "en": "Look outside! Why are the students protesting?",
          "tr": "Dışarı bak! Öğrenciler neden protesto ediyor?"
        },
        {
          "en": "They want more freedom.",
          "tr": "Daha fazla özgürlük istiyorlar."
        },
        {
          "en": "It's high time the university listened.",
          "tr": "Üniversitenin dinleme zamanı geldi de geçiyor."
        },
        {
          "en": "Are they a majority or a minority?",
          "tr": "Çoğunluktalar mı yoksa azınlıkta mı?"
        },
        {
          "en": "A vast majority of students are there.",
          "tr": "Öğrencilerin büyük çoğunluğu orada."
        },
        {
          "en": "Good. Discrimination is a threat to everyone.",
          "tr": "Güzel. Ayrımcılık herkes için bir tehdittir."
        }
      ]
    },
    {
      "id": "b2-society-3",
      "title": "Seçim zamanı",
      "names": [
        "Murat",
        "Elif"
      ],
      "lines": [
        {
          "en": "The election is tomorrow. Who will you vote for?",
          "tr": "Seçim yarın. Kime oy vereceksin?"
        },
        {
          "en": "I don't know. Unemployment is a heavy burden.",
          "tr": "Bilmiyorum. İşsizlik ağır bir yük."
        },
        {
          "en": "That's a fair point. We need equality.",
          "tr": "Haklısın. Eşitliğe ihtiyacımız var."
        },
        {
          "en": "I see what you mean, but how?",
          "tr": "Ne demek istediğini anlıyorum ama nasıl?"
        },
        {
          "en": "They must find jobs for the younger generation.",
          "tr": "Genç nesil için iş bulmalılar."
        },
        {
          "en": "It seems to me that it will take time.",
          "tr": "Bana öyle geliyor ki bu zaman alacak."
        }
      ]
    },
    {
      "id": "b2-society-4",
      "title": "Başkalarına yardım",
      "names": [
        "Sarah",
        "London",
        "Kemal"
      ],
      "lines": [
        {
          "en": "Sarah works for a charity in London.",
          "tr": "Sarah Londra'da bir hayır kurumunda çalışıyor."
        },
        {
          "en": "She tries to help poor immigrants.",
          "tr": "Yoksul göçmenlere yardım etmeye çalışıyor."
        },
        {
          "en": "Do they receive welfare from the government?",
          "tr": "Hükümetten sosyal yardım alıyorlar mı?"
        },
        {
          "en": "Not always. Therefore, the charity is essential.",
          "tr": "Her zaman değil. Bu yüzden hayır kurumu şart."
        },
        {
          "en": "Kemal is a volunteer there.",
          "tr": "Kemal orada bir gönüllü."
        },
        {
          "en": "He starts campaigns for food.",
          "tr": "Yemek için kampanyalar başlatıyor."
        }
      ]
    },
    {
      "id": "b2-society-5",
      "title": "Daha iyi bir toplum",
      "names": [
        "David",
        "Emma"
      ],
      "lines": [
        {
          "en": "Democracy requires respect for every citizen.",
          "tr": "Demokrasi her vatandaşa saygı gerektirir."
        },
        {
          "en": "Yes, we must respect the minority.",
          "tr": "Evet, azınlığa saygı duymalıyız."
        },
        {
          "en": "Otherwise, we can't be safe together.",
          "tr": "Aksi takdirde birlikte güvende olamayız."
        },
        {
          "en": "As a result, the community will fail.",
          "tr": "Sonuç olarak toplum başarısız olur."
        },
        {
          "en": "On the whole, learning is the best solution.",
          "tr": "Genel olarak en iyi çözüm öğrenmektir."
        },
        {
          "en": "I agree. It is up to us.",
          "tr": "Katılıyorum. Bu bize bağlı."
        }
      ]
    }
  ]
}
