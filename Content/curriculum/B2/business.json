  "stories": [
    {
      "id": "b2-business-1",
      "title": "Yeni Müşteri",
      "names": [
        "Ali",
        "Sarah"
      ],
      "lines": [
        {
          "en": "Let's get down to business. We have a new client.",
          "tr": "İş konuşalım. Yeni bir müşterimiz var."
        },
        {
          "en": "I read the proposal. Our first priority is to help them.",
          "tr": "Teklifi okudum. İlk önceliğimiz onlara yardım etmek."
        },
        {
          "en": "Yes. The first objective is to establish a good relationship.",
          "tr": "Evet. İlk hedef iyi bir ilişki kurmak."
        },
        {
          "en": "We must delegate some work to the team.",
          "tr": "Ekibe biraz iş devretmeliyiz."
        },
        {
          "en": "I see what you mean, but we're running out of time.",
          "tr": "Ne demek istediğini anlıyorum ama zamanımız tükeniyor."
        },
        {
          "en": "I will talk to the manager and I'll get back to you.",
          "tr": "Yöneticiyle konuşacağım ve sana döneceğim."
        }
      ]
    },
    {
      "id": "b2-business-2",
      "title": "Büyüme Stratejisi",
      "names": [
        "Canan",
        "John",
        "Asia"
      ],
      "lines": [
        {
          "en": "Our biggest competitor is expanding into Asia.",
          "tr": "En büyük rakibimiz Asya'ya açılıyor."
        },
        {
          "en": "Therefore, we need a new strategy.",
          "tr": "Bu nedenle, yeni bir stratejiye ihtiyacımız var."
        },
        {
          "en": "We can establish a new partnership.",
          "tr": "Yeni bir ortaklık kurabiliriz."
        },
        {
          "en": "That carries a considerable risk.",
          "tr": "Bu ciddi bir risk taşıyor."
        },
        {
          "en": "It seems to me that it is a win-win situation.",
          "tr": "Bana öyle geliyor ki bu kazan-kazan bir durum."
        },
        {
          "en": "That's a fair point. Could we go over the plan tomorrow?",
          "tr": "Bu haklı bir nokta. Planın üstünden yarın geçebilir miyiz?"
        }
      ]
    },
    {
      "id": "b2-business-3",
      "title": "Su Sıkıntısı",
      "names": [
        "Murat",
        "Emma"
      ],
      "lines": [
        {
          "en": "Our profits are declining this year.",
          "tr": "Kârlarımız bu yıl düşüyor."
        },
        {
          "en": "It is because of the water shortage.",
          "tr": "Bunun nedeni su sıkıntısı."
        },
        {
          "en": "We must improve our efficiency.",
          "tr": "Verimliliğimizi artırmalıyız."
        },
        {
          "en": "If we make a new deal, we can save money.",
          "tr": "Eğer yeni bir anlaşma yaparsak, para tasarrufu yapabiliriz."
        },
        {
          "en": "Are you certain that we can maintain our quality?",
          "tr": "Kalitemizi koruyabileceğimizden emin misin?"
        },
        {
          "en": "Yes, it is an adequate solution.",
          "tr": "Evet, bu yeterli bir çözüm."
        }
      ]
    },
    {
      "id": "b2-business-4",
      "title": "Uygulama Yatırımı",
      "names": [
        "Zeynep",
        "Paul"
      ],
      "lines": [
        {
          "en": "We plan to launch the new app next week.",
          "tr": "Yeni uygulamayı haftaya başlatmayı planlıyoruz."
        },
        {
          "en": "I think we should invest more money in it.",
          "tr": "Bence ona daha fazla para yatırmalıyız."
        },
        {
          "en": "Is this a good investment?",
          "tr": "Bu iyi bir yatırım mı?"
        },
        {
          "en": "Yes. It will enhance our relationship with the customers.",
          "tr": "Evet. Müşterilerle olan ilişkimizi geliştirecek."
        },
        {
          "en": "I see what you mean, but it is very expensive.",
          "tr": "Ne demek istediğini anlıyorum ama çok pahalı."
        },
        {
          "en": "Nevertheless, we must try it.",
          "tr": "Yine de bunu denemeliyiz."
        }
      ]
    },
    {
      "id": "b2-business-5",
      "title": "Fiyat Görüşmesi",
      "names": [
        "David",
        "Leyla"
      ],
      "lines": [
        {
          "en": "We must negotiate the price with the new client.",
          "tr": "Yeni müşteriyle fiyat konusunda pazarlık yapmalıyız."
        },
        {
          "en": "They have a tendency to ask for a big discount.",
          "tr": "Büyük bir indirim isteme eğilimindeler."
        },
        {
          "en": "We can offer them a better deal.",
          "tr": "Onlara daha iyi bir anlaşma sunabiliriz."
        },
        {
          "en": "Could we go over the price now?",
          "tr": "Fiyatın üstünden şimdi geçebilir miyiz?"
        },
        {
          "en": "We're running out of time today.",
          "tr": "Bugün zamanımız tükeniyor."
        },
        {
          "en": "OK, I'll get back to you tomorrow morning.",
          "tr": "Tamam, sana yarın sabah döneceğim."
        }
      ]
    }
  ],
  "names": [
    "London"
  ]
}
