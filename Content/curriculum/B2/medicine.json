  "stories": [
    {
      "id": "b2-medicine-1",
      "title": "A Visit to the Doctor",
      "title_tr": "Doktor Ziyareti",
      "names": [
        "Zeynep",
        "Dr",
        "Smith"
      ],
      "lines": [
        {
          "en": "Zeynep feels ill and visits Dr. Smith.",
          "tr": "Zeynep hasta hissediyor ve Dr. Smith'i ziyaret ediyor."
        },
        {
          "en": "I've been feeling under the weather.",
          "tr": "Kendimi keyifsiz hissediyorum."
        },
        {
          "en": "We need an accurate diagnosis.",
          "tr": "Doğru bir teşhise ihtiyacımız var."
        },
        {
          "en": "Is it a chronic disease?",
          "tr": "Kronik bir hastalık mı?"
        },
        {
          "en": "No, it is just a small infection.",
          "tr": "Hayır, sadece küçük bir enfeksiyon."
        },
        {
          "en": "Will I undergo surgery?",
          "tr": "Ameliyat olacak mıyım?"
        },
        {
          "en": "No. Just get some fresh air.",
          "tr": "Hayır. Sadece biraz temiz hava al."
        }
      ]
    },
    {
      "id": "b2-medicine-2",
      "title": "A Genetic Allergy",
      "title_tr": "Genetik Alerji",
      "names": [
        "Ali",
        "Hasan"
      ],
      "lines": [
        {
          "en": "I have a bad allergy to milk.",
          "tr": "Süte karşı kötü bir alerjim var."
        },
        {
          "en": "Really? My son has it too.",
          "tr": "Gerçekten mi? Oğlumda da var."
        },
        {
          "en": "It runs in the family. We inherited it.",
          "tr": "Bizde aileden geliyor. Bize genetik geçti."
        },
        {
          "en": "Does it require therapy?",
          "tr": "Terapi gerektiriyor mu?"
        },
        {
          "en": "No, I merely avoid milk.",
          "tr": "Hayır, sadece sütten uzak duruyorum."
        },
        {
          "en": "Prevention is better than cure.",
          "tr": "Önlemek tedavi etmekten iyidir."
        }
      ]
    },
    {
      "id": "b2-medicine-3",
      "title": "The Road to Recovery",
      "title_tr": "İyileşme Süreci",
      "names": [
        "Ayşe",
        "London"
      ],
      "lines": [
        {
          "en": "Ayşe had cancer, but she is better now.",
          "tr": "Ayşe kanserdi ama şimdi daha iyi."
        },
        {
          "en": "A friend visits Ayşe in London.",
          "tr": "Bir arkadaşı Londra'da Ayşe'yi ziyaret ediyor."
        },
        {
          "en": "You look very healthy today.",
          "tr": "Bugün çok sağlıklı görünüyorsun."
        },
        {
          "en": "Yes, I'm on the mend.",
          "tr": "Evet, iyileşme yolundayım."
        },
        {
          "en": "Did the new medicine heal you?",
          "tr": "Yeni ilaç mı seni iyileştirdi?"
        },
        {
          "en": "Yes, it is a genuine cure.",
          "tr": "Evet, gerçek bir çare oldu."
        }
      ]
    },
    {
      "id": "b2-medicine-4",
      "title": "Healthy Living",
      "title_tr": "Sağlıklı Yaşam",
      "names": [
        "Burak",
        "David"
      ],
      "lines": [
        {
          "en": "Obesity is a significant problem today.",
          "tr": "Obezite günümüzde önemli bir sorun."
        },
        {
          "en": "I see what you mean, but why?",
          "tr": "Ne demek istediğini anlıyorum, ama neden?"
        },
        {
          "en": "It's sugar addiction.",
          "tr": "Sebep şeker bağımlılığı."
        },
        {
          "en": "We must improve our diets.",
          "tr": "Diyetlerimizi geliştirmeliyiz."
        },
        {
          "en": "Yes, good nutrition can prevent diseases.",
          "tr": "Evet, iyi beslenme hastalıkları önleyebilir."
        }
      ]
    },
    {
      "id": "b2-medicine-5",
      "title": "Organs and Vaccines",
      "title_tr": "Organ ve Aşı",
      "names": [
        "Brown",
        "Lisa"
      ],
      "lines": [
        {
          "en": "The stomach is an important organ.",
          "tr": "Mide önemli bir organdır."
        },
        {
          "en": "Do I need to undergo surgery?",
          "tr": "Ameliyat olmam gerekiyor mu?"
        },
        {
          "en": "No, you merely need a vaccine.",
          "tr": "Hayır, sadece bir aşıya ihtiyacınız var."
        },
        {
          "en": "Will it make me immune?",
          "tr": "Beni bağışık yapacak mı?"
        },
        {
          "en": "Yes. Are you feeling well?",
          "tr": "Evet. Kendinizi iyi hissediyor musunuz?"
        },
        {
          "en": "No, I've been feeling under the weather.",
          "tr": "Hayır, kendimi keyifsiz hissediyorum."
        },
        {
          "en": "You must consult me again later.",
          "tr": "Daha sonra bana tekrar danışmalısınız."
        }
      ]
    }
  ]
}
