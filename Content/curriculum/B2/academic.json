  "stories": [
    {
      "id": "b2-academic-1",
      "title": "Burs ve Eğitim",
      "names": [
        "Ozan",
        "London",
        "English"
      ],
      "lines": [
        {
          "en": "Ozan is a student in London. He studies English.",
          "tr": "Ozan Londra'da bir öğrenci. İngilizce çalışıyor."
        },
        {
          "en": "Did you get a scholarship?",
          "tr": "Burs aldın mı?"
        },
        {
          "en": "Yes! Tuition is very expensive here. The scholarship is essential.",
          "tr": "Evet! Burada okul ücreti çok pahalı. Burs şart."
        },
        {
          "en": "That's a fair point. Do you like the curriculum?",
          "tr": "Haklısın. Müfredatı seviyor musun?"
        },
        {
          "en": "It is difficult, but I try to keep my discipline.",
          "tr": "Zor ama disiplinimi korumaya çalışıyorum."
        },
        {
          "en": "I want to emphasize that you are very clever.",
          "tr": "Çok zeki olduğunu vurgulamak isterim."
        }
      ]
    },
    {
      "id": "b2-academic-2",
      "title": "Uzun Bir Seminer",
      "names": [
        "Zeynep",
        "Ali"
      ],
      "lines": [
        {
          "en": "Zeynep and Ali are on campus.",
          "tr": "Zeynep ve Ali kampüsteler."
        },
        {
          "en": "Are you ready for the seminar?",
          "tr": "Seminer için hazır mısın?"
        },
        {
          "en": "Not really. The last lecture was so long.",
          "tr": "Pek sayılmaz. Geçen ders çok uzundu."
        },
        {
          "en": "I see what you mean, but this concept is important.",
          "tr": "Ne demek istediğini anlıyorum ama bu kavram önemli."
        },
        {
          "en": "On top of that, we have a big assessment tomorrow.",
          "tr": "Üstelik yarın büyük bir değerlendirmemiz var."
        },
        {
          "en": "Correct me if I'm wrong. The exam is in the morning, right?",
          "tr": "Yanlışım varsa düzelt. Sınav sabah, değil mi?"
        }
      ]
    },
    {
      "id": "b2-academic-3",
      "title": "Ödev Zamanı",
      "names": [
        "Cem",
        "Elif"
      ],
      "lines": [
        {
          "en": "Cem is studying on campus.",
          "tr": "Cem kampüste ders çalışıyor."
        },
        {
          "en": "My assignment is quite difficult. I must evaluate this article.",
          "tr": "Ödevim oldukça zor. Bu makaleyi değerlendirmeliyim."
        },
        {
          "en": "Let me give you an example. You can summarize the first part.",
          "tr": "Sana bir örnek vereyim. İlk kısmı özetleyebilirsin."
        },
        {
          "en": "This raises the question of plagiarism.",
          "tr": "Bu, intihal sorununu akla getiriyor."
        },
        {
          "en": "Yes. You must include a reference for every source.",
          "tr": "Evet. Her kaynak için bir referans eklemelisin."
        },
        {
          "en": "To sum up, I have a lot of work to do.",
          "tr": "Özetle, yapacak çok işim var."
        }
      ]
    },
    {
      "id": "b2-academic-4",
      "title": "Tez Teslimi",
      "names": [
        "Ayşe",
        "David"
      ],
      "lines": [
        {
          "en": "Ayşe talks to David.",
          "tr": "Ayşe David ile konuşuyor."
        },
        {
          "en": "I finally finished my thesis!",
          "tr": "Sonunda tezimi bitirdim!"
        },
        {
          "en": "That is great news. The faculty will review it soon.",
          "tr": "Bu harika bir haber. Fakülte yakında inceleyecektir."
        },
        {
          "en": "I hope so. I am a little nervous about the outcome.",
          "tr": "Umarım. Sonuç hakkında biraz gerginim."
        },
        {
          "en": "It seems to me that you did a great job.",
          "tr": "Bana öyle geliyor ki harika bir iş çıkardın."
        },
        {
          "en": "Thank you! I used a critical approach.",
          "tr": "Teşekkürler! Eleştirel bir yaklaşım kullandım."
        }
      ]
    },
    {
      "id": "b2-academic-5",
      "title": "Derse Doğru",
      "names": [
        "Leyla",
        "Hasan"
      ],
      "lines": [
        {
          "en": "Leyla and Hasan walk to their faculty.",
          "tr": "Leyla ve Hasan fakültelerine yürüyorlar."
        },
        {
          "en": "Did you finish the essay?",
          "tr": "Makaleyi bitirdin mi?"
        },
        {
          "en": "Almost. I just need one more reference.",
          "tr": "Neredeyse. Sadece bir referansa daha ihtiyacım var."
        },
        {
          "en": "Otherwise, the teacher might be angry.",
          "tr": "Aksi takdirde öğretmen kızabilir."
        },
        {
          "en": "That's true. Academic discipline is an important aspect of university life.",
          "tr": "Doğru. Akademik disiplin üniversite hayatının önemli bir yönüdür."
        },
        {
          "en": "Let's run! The lecture starts soon.",
          "tr": "Koşalım! Ders birazdan başlıyor."
        }
      ]
    }
  ]
}
